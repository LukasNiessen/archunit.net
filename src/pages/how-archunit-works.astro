---
import CodeWindow from '@components/CodeWindow.astro';
import InlineCode from '@components/InlineCode.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

const pythonRule = [
  'from archunitpython import project_files, assert_passes',
  '',
  'rule = (',
  '    project_files("src/")',
  '    .in_folder("**/api/**")',
  '    .should_not()',
  '    .depend_on_files()',
  '    .in_folder("**/infrastructure/**")',
  '    .because("the API must depend on ports, not adapters")',
  ')',
  '',
  'assert_passes(rule)',
].join('\n');

const typescriptRule = [
  "import { projectFiles } from 'archunit';",
  '',
  'const rule = projectFiles()',
  "  .inFolder('src/api/**')",
  '  .shouldNot()',
  '  .dependOnFiles()',
  "  .inFolder('src/infrastructure/**');",
  '',
  'await expect(rule).toPassAsync();',
].join('\n');

const pythonExtraction = [
  'excludes = _resolve_exclude_patterns(project_path, patterns)',
  'py_files = _find_python_files(project_path, excludes)',
  'known_files = {_normalize(path) for path in py_files}',
  '',
  'for file_path in py_files:',
  '    edges.append(Edge(file_path, file_path, external=False))',
  '    with open(file_path, "r", encoding="utf-8", errors="replace") as f:',
  '        source = f.read()',
  '    tree = ast.parse(source, filename=file_path)',
  '',
  '    for node in ast.walk(tree):',
  '        located = classify_import(node)',
  '        if located is None:',
  '            continue',
  '        for target, external in _resolve_import_targets(',
  '            located, file_path, project_path',
  '        ):',
  '            if external or target in known_files:',
  '                edges.append(Edge(',
  '                    source=_normalize(file_path),',
  '                    target=target,',
  '                    external=external,',
  '                    import_kinds=_edge_import_kinds(located),',
  '                ))',
  '',
  'return _merge_edges(edges)',
].join('\n');

const typescriptExtraction = [
  'const contexts: ts.ParsedCommandLine[] = [];',
  'const visited = new Set<string>();',
  '',
  'function visitConfig(configPath: string) {',
  '  const identity = path.resolve(configPath);',
  '  if (visited.has(identity)) return;',
  '  visited.add(identity);',
  '',
  '  const source = ts.readConfigFile(identity, ts.sys.readFile);',
  '  const parsed = ts.parseJsonConfigFileContent(',
  '    source.config, ts.sys, path.dirname(identity), {}, identity',
  '  );',
  '  contexts.push(parsed);',
  '',
  '  for (const ref of parsed.projectReferences ?? []) {',
  '    visitConfig(ts.resolveProjectReferencePath(ref));',
  '  }',
  '}',
  '',
  'visitConfig("tsconfig.json");',
  'const options = contexts[0].options;',
  'const host = ts.createCompilerHost(options);',
  'const rootNames = [...new Set(contexts.flatMap(c => c.fileNames))];',
  'const program = ts.createProgram({ rootNames, options, host });',
  '',
  'for (const sourceFile of program.getSourceFiles()) {',
  '  ts.forEachChild(sourceFile, node => {',
  '    if (!ts.isImportDeclaration(node)) return;',
  '    const moduleName = (node.moduleSpecifier as { text?: string }).text;',
  '    if (!moduleName) return;',
  '    const resolved = ts.resolveModuleName(',
  '      moduleName, sourceFile.fileName, options, host',
  '    ).resolvedModule;',
  '    if (!resolved) return;',
  '    imports.push({',
  '      source: normalize(sourceFile.fileName),',
  '      target: normalize(resolved.resolvedFileName),',
  '      external: resolved.isExternalLibraryImport ?? false,',
  '      importKinds: determineImportKinds(node),',
  '    });',
  '  });',
  '}',
].join('\n');

const pythonGraphModel = [
  'class ImportKind(Enum):',
  '    IMPORT = "import"',
  '    FROM_IMPORT = "from_import"',
  '    RELATIVE_IMPORT = "relative"',
  '    DYNAMIC_IMPORT = "dynamic"',
  '    TYPE_IMPORT = "type"',
  '    CONDITIONAL_IMPORT = "conditional"',
  '',
  '@dataclass(frozen=True)',
  'class Edge:',
  '    source: str',
  '    target: str',
  '    external: bool',
  '    import_kinds: tuple[ImportKind, ...] = ()',
].join('\n');

const typescriptGraphModel = [
  'export type Edge = {',
  '  source: string;',
  '  target: string;',
  '  external: boolean;',
  '  importKinds: ImportKind[];',
  '};',
  '',
  'export type Graph = Edge[];',
].join('\n');

const evaluationModel = [
  'subjects = graph.nodes.filter(subject_selector)',
  '',
  'if subjects.is_empty() and not options.allow_empty_tests:',
  '    return [EmptyTestViolation(subject_selector)]',
  '',
  'candidate_edges = graph.outgoing_edges(subjects)',
  'violations = [',
  '    edge for edge in candidate_edges',
  '    if target_selector(edge.target)',
  ']',
  '',
  'return CheckResult(rule=rule, violations=violations)',
].join('\n');

const stages = [
  {
    number: '01',
    eyebrow: 'Source',
    title: 'Find the project that actually ships.',
    body: 'A rule begins with a real project root and its language toolchain. ArchUnit does not start from a diagram or a manually maintained inventory.',
    python:
      'Python walks .py files beneath the selected root. Built-in exclusions skip environments, caches, builds, and generated package metadata; .archignore adds project-specific omissions.',
    pythonCode: 'for dirpath, dirnames, filenames in os.walk(project_root):',
    typescript:
      'TypeScript starts from tsconfig.json, including its include and exclude rules, compiler options, path aliases, and referenced projects.',
    typescriptCode: 'const config = ts.readConfigFile(configPath, ts.sys.readFile);',
  },
  {
    number: '02',
    eyebrow: 'Extract',
    title: 'Read dependency evidence without running the application.',
    body: 'Only source-backed relationships enter the model. The language adapter owns syntax and resolution; downstream architecture logic never needs to understand an import statement.',
    python:
      'Python uses ast.parse(), recognizes import, from import, relative imports, literal dynamic imports, TYPE_CHECKING blocks, and conditional ImportError fallbacks.',
    pythonCode: 'tree = ast.parse(source, filename=file_path)',
    typescript:
      'TypeScript builds a Compiler API Program and resolves each import with the compiler host, using the same module-resolution settings as the project.',
    typescriptCode:
      'ts.forEachChild(sourceFile, node => ts.isImportDeclaration(node) && resolve(node));',
  },
  {
    number: '03',
    eyebrow: 'Graph',
    title: 'Turn files into nodes and imports into directed edges.',
    body: 'Paths are normalized, internal and external dependencies stay distinct, duplicate evidence is merged, and isolated source files remain visible through self-edges.',
    python:
      'An import from app.api.orders to app.infrastructure.sql becomes an edge from api/orders.py to infrastructure/sql.py. requests stays an external module edge.',
    pythonCode: 'Edge(source=file_path, target=resolved, external=is_external)',
    typescript:
      'The same model is produced for .ts and .tsx files. Project references and alias resolution can contribute valid edges without depending on reference order.',
    typescriptCode: 'const edge: Edge = { source, target, external, importKinds };',
  },
  {
    number: '04',
    eyebrow: 'Grammar',
    title: 'Build a sentence before doing expensive work.',
    body: 'The fluent API records a subject, a mood, a predicate, an object, and optionally a rationale. Builders describe intent; the terminal check performs extraction and evaluation.',
    python:
      'project_files("src/").in_folder("**/api/**").should_not().depend_on_files().in_folder("**/infrastructure/**")',
    pythonCode: 'project_files("src/").in_folder("**/api/**").should_not()',
    typescript:
      'projectFiles().inFolder("src/api/**").shouldNot().dependOnFiles().inFolder("src/infrastructure/**")',
    typescriptCode: 'projectFiles().inFolder("src/api/**").shouldNot()',
  },
  {
    number: '05',
    eyebrow: 'Project and assert',
    title: 'Ask a focused question of the graph.',
    body: 'A file rule projects edges, a layer rule groups their endpoints by named regions, a slice rule derives component names, and a metric rule projects measurable source facts.',
    python:
      'The dependency evaluator filters source edges by the API selector, tests their targets against the infrastructure selector, and emits one typed violation for every forbidden match.',
    pythonCode: '_resolve_import_targets(import_, file_path, project_path)',
    typescript:
      'ArchUnitTS follows the same projection and violation boundary asynchronously, which lets test-runner adapters await compiler-backed extraction.',
    typescriptCode: 'ts.resolveModuleName(moduleName, sourceFile.fileName, options, compilerHost)',
  },
  {
    number: '06',
    eyebrow: 'Semantics',
    title: 'Make negation and empty tests explicit.',
    body: 'should_not changes the condition being evaluated; it does not invert whether the test runner passes. Zero selected subjects are a violation by default, because an architecture test that checks nothing is false confidence.',
    python:
      'CheckOptions(allow_empty_tests=True) is the deliberate opt-out. Otherwise a stale **/api/** pattern produces EmptyTestViolation instead of a green build.',
    pythonCode: 'CheckOptions(allow_empty_tests=True)',
    typescript:
      'ArchUnitTS uses allowEmptyTests for the same opt-out and records the unmatched filter in EmptyTestViolation.',
    typescriptCode: 'const options = { allowEmptyTests: true };',
  },
  {
    number: '07',
    eyebrow: 'Algorithms',
    title: 'Use graph algorithms where local matching is not enough.',
    body: 'Dependency direction is an edge question. Cycles are a graph question. Layer policies, slices, coupling, instability, and reachability each use the projection suited to their architectural meaning.',
    python:
      'Cycle detection first uses Tarjan to isolate strongly connected components, then Johnson to enumerate the simple cycles inside each relevant component.',
    pythonCode: 'cycles = calculate_cycles(number_edges)',
    typescript:
      'The TypeScript implementation follows the same two-stage approach over internal projected edges, then converts complete paths into cycle violations.',
    typescriptCode: 'const cycles = calculateCycles(numberEdges);',
  },
  {
    number: '08',
    eyebrow: 'Feedback',
    title: 'Keep findings structured until the delivery boundary.',
    body: 'Rules return violation data. Assertion adapters turn that data into pytest, Jest, Vitest, xUnit, or native test failures; reporters turn it into text, JSON, diagrams, SARIF, or HTML where supported.',
    python:
      'assert_passes() calls check(), formats every violation with concrete evidence, includes the because() rationale, and raises AssertionError only at the final boundary.',
    pythonCode: 'assert_passes(rule)',
    typescript:
      'toPassAsync() integrates with the runner, while check() remains available for custom workflows and report generation.',
    typescriptCode: 'await expect(rule).toPassAsync();',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'How ArchUnit libraries work',
  description:
    'A source-backed walkthrough of project discovery, dependency extraction, graph construction, fluent rules, evaluation, cycle algorithms, and test feedback in ArchUnit libraries.',
  author: { '@type': 'Organization', name: 'ArchUnit' },
  publisher: { '@type': 'Organization', name: 'ArchUnit' },
  mainEntityOfPage: 'https://www.archunit.net/how-archunit-works/',
};
---

<BaseLayout
  title="How ArchUnit libraries work"
  description="See how ArchUnit turns Python, TypeScript, and other projects into dependency graphs, evaluates fluent architecture rules, detects cycles, and returns useful test feedback."
  canonicalPath="/how-archunit-works/"
  schema={schema}
  alternateHeader
>
  <section class="how-hero">
    <div class="shell how-hero__inner">
      <p class="hero-kicker">From source code to architectural feedback</p>
      <h1>
        How ArchUnit <em>sees your system.</em>
      </h1>
      <div class="how-hero__copy">
        <p>
          Every library adapts to its language, but the underlying journey is recognizable: find
          source, extract dependency evidence, build a graph, evaluate a sentence, and return proof.
        </p>
        <p>
          Follow one Python boundary all the way through. TypeScript appears beside it at every
          language-specific turn, with the other libraries choosing their own native extraction
          strategy.
        </p>
      </div>
      <a class="how-scroll-cue" href="#walkthrough">
        Begin the walkthrough ↓
      </a>
    </div>
  </section>

  <section class="how-thesis">
    <div class="shell how-thesis__grid">
      <p class="how-thesis__statement">
        Architecture becomes testable when <strong>source files</strong> become nodes,
        <strong>dependencies</strong> become edges, and a decision becomes a question the graph can
        answer.
      </p>
      <div class="how-pipeline" aria-label="ArchUnit processing pipeline">
        <span>Source</span>
        <b>→</b>
        <span>Extract</span>
        <b>→</b>
        <span>Project</span>
        <b>→</b>
        <span>Assert</span>
        <b>→</b>
        <span>Report</span>
      </div>
    </div>
  </section>

