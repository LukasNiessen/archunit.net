  <script>
    const walkthrough = document.querySelector<HTMLElement>('[data-how-walkthrough]');
    const visual = walkthrough?.querySelector<HTMLElement>('[data-how-visual]');
    const counter = visual?.querySelector<HTMLElement>('[data-how-counter]');
    const title = visual?.querySelector<HTMLElement>('[data-how-title]');
    const caption = visual?.querySelector<HTMLElement>('[data-how-caption]');
    const stageElements = Array.from(
      walkthrough?.querySelectorAll<HTMLElement>('[data-how-stage]') ?? [],
    );

    const activateStage = (stage: HTMLElement) => {
      const value = stage.dataset.howStage ?? '1';
      visual?.setAttribute('data-active-stage', value);
      stageElements.forEach((candidate) =>
        candidate.toggleAttribute('data-active', candidate === stage),
      );
      if (counter) counter.textContent = `${value.padStart(2, '0')} / 08`;
      if (title) title.textContent = stage.dataset.howTitle ?? '';
      if (caption) caption.textContent = stage.dataset.howCaption ?? '';
    };

    if ('IntersectionObserver' in window && stageElements.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) activateStage(visible.target as HTMLElement);
        },
        { rootMargin: '-28% 0px -38% 0px', threshold: [0.15, 0.35, 0.6] },
      );
      stageElements.forEach((stage) => observer.observe(stage));
      const firstStage = stageElements[0];
      if (firstStage) activateStage(firstStage);
    }
  </script>
