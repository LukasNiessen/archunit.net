---
import ConversionBand from '@components/ConversionBand.astro';
import SectionHeading from '@components/SectionHeading.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

const principles = [
  {
    title: 'Evidence before ceremony',
    copy: 'A useful architecture decision should produce evidence in the same delivery loop as the code it protects.',
  },
  {
    title: 'Native before uniform',
    copy: 'Shared concepts matter, but every library should respect its language, build system, and testing culture.',
  },
  {
    title: 'Clarity before coverage',
    copy: 'A small set of trusted rules is more valuable than a broad policy suite that teams learn to ignore.',
  },
  {
    title: 'Open work compounds',
    copy: 'Documentation, examples, fixes, and design discussion create a foundation that every ecosystem can build on.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About ArchUnit',
  url: 'https://www.archunit.net/about/',
  description:
    'How the ArchUnit team builds language-native architecture testing libraries and executable engineering guardrails.',
};
---

<BaseLayout
  title="About"
  description="Learn how the ArchUnit team builds language-native architecture testing libraries and executable engineering guardrails."
  canonicalPath="/about/"
  schema={schema}
>
  <section class="company-hero">
    <div class="shell company-hero__grid">
      <div>
        <p class="hero-kicker">About ArchUnit</p>
        <h1>Architecture decisions that stay close to the code.</h1>
      </div>
      <div class="company-hero__copy">
        <p>
          ArchUnit is a family of open-source libraries for teams that want software structure to
          remain testable as products, organizations, and codebases evolve.
        </p>
        <div class="company-hero__links">
          <a class="button button--lime" href="/team/">
            Meet the team
          </a>
          <a class="button button--ghost" href="/jobs/">
            Explore jobs
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="company-story-section">
    <div class="shell company-story-grid">
      <div>
        <p class="eyebrow">What we are building</p>
        <h2>A shared model, expressed natively.</h2>
      </div>
      <div>
        <p>
          The project began with one practical gap: a TypeScript team needed a capable way to test
          architectural boundaries inside its ordinary test suite. ArchUnitTS became that tool, and
          the same product idea has since expanded across Python, .NET, Ruby, Rust, Zig, Go, Java,
          and PHP.
        </p>
        <p>
          The libraries share a recognizable vocabulary for dependencies, layers, cycles, slices,
          and design metrics. They do not force identical implementations. Python can use its AST,
          TypeScript can use the compiler API, and every ecosystem can choose the integration that
          feels natural to its developers.
        </p>
        <p>
          Our goal is straightforward: turn architectural intent into feedback that is precise
          enough to trust, fast enough to use, and clear enough to act on.
        </p>
      </div>
    </div>
  </section>

  <section class="company-principles-section">
    <div class="shell">
      <SectionHeading
        eyebrow="How we work"
        title="Principles for durable developer tools."
        copy="The best guardrail is not the loudest one. It is the one a team understands, trusts, and keeps running."
      />
      <div class="company-principles-grid">
        {principles.map((principle, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="company-open-section">
    <div class="shell company-open-grid">
      <div>
        <p class="eyebrow">Built in the open</p>
        <h2>A product direction shaped by real repositories.</h2>
      </div>
      <div>
        <p>
          Open source keeps the work grounded. Users can inspect how a graph is built, reproduce a
          rule result, contribute an edge case, and carry an idea from one ecosystem into another.
        </p>
        <p>
          That collaboration is also how the project grows. We are a small team working with a wider
          contributor community, and we care about thoughtful engineering more than where it
          happens.
        </p>
        <a class="text-link" href="/team/">
          Meet the people behind ArchUnit →
        </a>
      </div>
    </div>
  </section>

  <ConversionBand
    eyebrow="Work with us"
    title="Build architecture tools developers want to keep."
    copy="Explore open roles in engineering and go to market, or start a conversation about using ArchUnit with your team."
    primaryLabel="View open roles"
    primaryHref="/jobs/"
  />
</BaseLayout>
