---
import CodeWindow from '@components/CodeWindow.astro';
import ConversionBand from '@components/ConversionBand.astro';
import { contactEmail, team } from '@data/contributors';
import { posts, type BlogPost } from '@data/posts';
import BaseLayout from '@layouts/BaseLayout.astro';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const articleAuthors = team.filter((member) => post.authorSlugs?.includes(member.slug));
const authorLabel = articleAuthors.length
  ? articleAuthors.map((author) => author.name).join(' and ')
  : 'ArchUnit platform';
const authorSchema = articleAuthors.length
  ? articleAuthors.map((author) => ({
      '@type': 'Person',
      name: author.name,
      url: 'https://www.archunit.net/team/' + author.slug + '/',
    }))
  : { '@type': 'Organization', name: 'ArchUnit' };
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.summary,
    datePublished: post.published,
    author: authorSchema,
    publisher: { '@type': 'Organization', name: 'ArchUnit' },
    mainEntityOfPage: 'https://www.archunit.net/blog/' + post.slug + '/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.archunit.net/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.archunit.net/blog/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.title,
        item: 'https://www.archunit.net/blog/' + post.slug + '/',
      },
    ],
  },
];
---

<BaseLayout
  title={post.title}
  description={post.summary}
  canonicalPath={'/blog/' + post.slug + '/'}
  schema={schema}
>
  <article>
    <header class="article-hero">
      <div class="shell article-hero__inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">ArchUnit</a>
          <span>/</span>
          <a href="/blog/">Blog</a>
          <span>/</span>
          <span>{post.category}</span>
        </nav>
        <div class="article-hero__meta">
          <span>{post.category}</span>
          <time datetime={post.published}>{post.publishedLabel}</time>
          <span>{post.readingTime}</span>
        </div>
        <p class="article-byline">
          By{' '}
          {articleAuthors.length ? (
            articleAuthors.map((author, index) => (
              <>
                <a href={'/team/' + author.slug + '/'}>{author.name}</a>
                {index < articleAuthors.length - 1 ? ' and ' : ''}
              </>
            ))
          ) : (
            <span>{authorLabel}</span>
          )}
        </p>
        <h1>{post.title}</h1>
        <p>{post.summary}</p>
      </div>
    </header>

    <div class="article-layout shell">
      <aside class="article-aside">
        <p class="eyebrow">In this article</p>
        <ol class="article-toc">
          {post.sections.map((section, index) => (
            <li>
              <a href={'#section-' + (index + 1)}>{section.heading}</a>
            </li>
          ))}
        </ol>
        <p class="article-source-note">{post.sourceNote}</p>
        <div class="article-aside-authors">
          <p class="eyebrow">Written by</p>
          {articleAuthors.length ? (
            articleAuthors.map((author) => (
              <a href={'/team/' + author.slug + '/'}>
                <img src={author.photoUrl} alt="" width="42" height="42" loading="lazy" />
                <span>
                  <strong>{author.name}</strong>
                  <small>{author.role}</small>
                </span>
              </a>
            ))
          ) : (
            <div class="article-platform-author">
              <img src="/logos/archunitts.png" alt="" width="42" height="42" />
              <span>
                <strong>ArchUnit platform</strong>
                <small>Editorial team</small>
              </span>
            </div>
          )}
        </div>
      </aside>
      <div class="article-body">
        {post.sections.map((section, index) => (
          <section id={'section-' + (index + 1)}>
            <span class="article-section-number">{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
            {section.code && (
              <CodeWindow
                code={section.code}
                filename={section.codeFilename ?? 'example.txt'}
                language={section.codeLanguage ?? 'text'}
                copy
              />
            )}
            {section.links && (
              <ul class="article-links" aria-label="Sources and reproduction links">
                {section.links.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noreferrer">
                      {link.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </article>

  <section class="article-author-section">
    <div class="shell">
      <p class="eyebrow">Contact the author</p>
      <div class="article-author-grid">
        <div>
          <h2>Continue the conversation.</h2>
          <p>
            Ask about the ideas in this article, discuss an architecture-testing use case, or share
            an edge case from your own codebase.
          </p>
        </div>
        <div class="article-author-cards">
          {articleAuthors.length ? (
            articleAuthors.map((author) => {
              const emailHref = `mailto:${contactEmail}?subject=${encodeURIComponent(
                'Contact ' + author.name + ' about: ' + post.title,
              )}`;
              return (
                <article>
                  <img
                    src={author.photoUrl}
                    alt={author.name}
                    width="160"
                    height="160"
                    loading="lazy"
                  />
                  <div>
                    <span>{author.role}</span>
                    <h3>{author.name}</h3>
                    <a class="button button--ghost" href={emailHref}>
                      Contact {author.name.split(' ')[0]}
                    </a>
                  </div>
                </article>
              );
            })
          ) : (
            <article>
              <img src="/logos/archunitts.png" alt="ArchUnit" width="160" height="160" />
              <div>
                <span>Editorial</span>
                <h3>ArchUnit platform</h3>
                <a
                  class="button button--ghost"
                  href={`mailto:${contactEmail}?subject=${encodeURIComponent('ArchUnit article inquiry')}`}
                >
                  Contact the team
                </a>
              </div>
            </article>
          )}
        </div>
      </div>
    </div>
  </section>

  <ConversionBand />
</BaseLayout>
