---
import { contactEmail, team, type TeamMember } from '@data/contributors';
import { posts } from '@data/posts';
import BaseLayout from '@layouts/BaseLayout.astro';

export function getStaticPaths() {
  return team.map((member) => ({ params: { slug: member.slug }, props: { member } }));
}

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const currentIndex = team.findIndex((candidate) => candidate.slug === member.slug);
const nextMember = team[(currentIndex + 1) % team.length] ?? team[0]!;
const otherMembers = team.filter((candidate) => candidate.slug !== member.slug);
const publishedPosts = posts.filter((post) => post.authorSlugs?.includes(member.slug));
const firstName = member.name.split(' ')[0];
const sameAs = [member.linkedinUrl, member.githubUrl].filter((url): url is string => Boolean(url));
const emailHref = `mailto:${contactEmail}?subject=${encodeURIComponent(`Contact ${member.name} via ArchUnit`)}`;
const demoHref = `mailto:${contactEmail}?subject=${encodeURIComponent('ArchUnit demo request')}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    name: member.name + ' at ArchUnit',
    url: 'https://www.archunit.net/team/' + member.slug + '/',
    mainEntity: {
      '@type': 'Person',
      name: member.name,
      jobTitle: member.role,
      description: member.bio,
      image: 'https://www.archunit.net' + member.photoUrl,
      email: contactEmail,
      sameAs,
      memberOf: {
        '@type': 'Organization',
        name: 'ArchUnit',
        url: 'https://www.archunit.net/',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.archunit.net/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Team',
        item: 'https://www.archunit.net/team/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: member.name,
        item: 'https://www.archunit.net/team/' + member.slug + '/',
      },
    ],
  },
];
---

<BaseLayout
  title={member.name}
  description={member.bio}
  canonicalPath={'/team/' + member.slug + '/'}
  image={member.photoUrl}
  schema={schema}
>
  <header class="profile-hero">
    <div class="shell">
      <nav class="breadcrumbs profile-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">ArchUnit</a>
        <span>/</span>
        <a href="/team/">People</a>
        <span>/</span>
        <span>{member.name}</span>
      </nav>

      <div class="profile-hero__banner">
        <div class="profile-hero__copy">
          <p class="eyebrow">{member.role}</p>
          <h1>{member.name}</h1>
          <p class="profile-headline">{member.bio}</p>
          <div class="profile-actions">
            <a class="button button--lime" href={emailHref}>
              Email {firstName}
            </a>
            <a
              class="button button--profile-ghost"
              href={member.linkedinUrl}
              target="_blank"
              rel="noreferrer"
            >
              LinkedIn ↗
            </a>
          </div>
          {member.githubUrl && (
            <a class="profile-github-link" href={member.githubUrl} target="_blank" rel="noreferrer">
              View GitHub profile ↗
            </a>
          )}
        </div>
        <div class="profile-portrait-stage">
          <img
            class="profile-portrait"
            src={member.cutoutUrl}
            alt={member.name}
            width="1256"
            height="1256"
          />
        </div>
      </div>
    </div>
  </header>

  <div class="profile-main">
    <section class="profile-story-section">
      <div class="shell profile-story-grid">
        <div>
          <p class="eyebrow">About {firstName}</p>
          <h2>{member.headline}</h2>
        </div>
        <div class="profile-story-copy">
          {member.profile.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    {publishedPosts.length > 0 && (
      <section class="profile-publications-section">
        <div class="shell">
          <div class="profile-publications-heading">
            <div>
              <p class="eyebrow">Published work</p>
              <h2>Ideas from {firstName}.</h2>
            </div>
            <a class="text-link" href="/blog/">
              Explore every article →
            </a>
          </div>
          <div class="profile-publications-grid">
            {publishedPosts.map((post) => (
              <a class="profile-publication-card" href={'/blog/' + post.slug + '/'}>
                <div class="profile-publication-card__visual">
                  <img src="/images/og-card.png" alt="" width="1200" height="630" loading="lazy" />
                  <span>{post.category}</span>
                </div>
                <div class="profile-publication-card__body">
                  <div>
                    <time datetime={post.published}>{post.publishedLabel}</time>
                    <span>{post.readingTime}</span>
                  </div>
                  <h3>{post.title}</h3>
                  <p>{post.summary}</p>
                  <strong>Read article ↗</strong>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="profile-focus-section">
      <div class="shell">
        <div class="profile-section-heading">
          <p class="eyebrow">Focus</p>
          <h2>Where {firstName} contributes.</h2>
        </div>
        <div class="profile-focus-grid">
          {member.focusAreas.map((area, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="profile-work-section">
      <div class="shell profile-work-grid">
        <div>
          <p class="eyebrow">Selected project work</p>
          <h2>Work that makes the library family stronger.</h2>
        </div>
        <ol>
          {member.projectWork.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="profile-principle-section">
      <div class="shell profile-principle">
        <p class="eyebrow">Working principle</p>
        <blockquote>“{member.workingPrinciple}”</blockquote>
      </div>
    </section>

    <section class="profile-contact-section" id="contact">
      <div class="shell profile-contact-card">
        <div>
          <p class="eyebrow">Contact {firstName}</p>
          <h2>Ready to make architecture visible?</h2>
        </div>
        <div>
          <p>
            Talk with {firstName} about architecture testing, the ArchUnit library family, or how
            executable guardrails can fit your engineering workflow.
          </p>
          <div class="profile-contact-actions">
            <a class="button button--lime" href={emailHref}>
              Email {firstName}
            </a>
            <a class="button button--ghost" href={demoHref}>
              Request a demo
            </a>
          </div>
          <a class="profile-contact-email" href={emailHref}>
            {contactEmail}
          </a>
        </div>
      </div>
    </section>

    <section class="profile-team-section">
      <div class="shell">
        <div class="profile-team-heading">
          <div>
            <p class="eyebrow">The team</p>
            <h2>Five perspectives, one project.</h2>
          </div>
          <a class="text-link" href="/team/">
            View the full team →
          </a>
        </div>
        <div class="profile-team-grid">
          {otherMembers.map((candidate) => (
            <a href={'/team/' + candidate.slug + '/'}>
              <img src={candidate.photoUrl} alt={candidate.name} width="800" height="800" />
              <span>{candidate.role}</span>
              <strong>{candidate.name}</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="profile-next-section">
      <a href={'/team/' + nextMember.slug + '/'}>
        <span>Meet another team member</span>
        <strong>{nextMember.name} →</strong>
      </a>
    </section>
  </div>
</BaseLayout>
