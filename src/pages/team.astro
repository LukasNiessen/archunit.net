---
import SectionHeading from '@components/SectionHeading.astro';
import { contributors, team } from '@data/contributors';
import BaseLayout from '@layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'The ArchUnit team',
  url: 'https://www.archunit.net/team/',
  description:
    'Meet the five-person team and wider contributor community behind the ArchUnit library family.',
};
---

<BaseLayout
  title="Team"
  description="Meet the five-person team and wider open-source contributor community behind the ArchUnit architecture-testing library family."
  canonicalPath="/team/"
  schema={schema}
>
  <section class="page-hero team-hero">
    <div class="shell">
      <h1>
        Five people, one shared <em>standard.</em>
      </h1>
      <div class="page-hero__copy">
        <p>
          We are a team of five people building architecture tests that feel native in every
          ecosystem they serve.
        </p>
        <p>
          We work across language tooling, graph analysis, developer experience, cloud platforms,
          and applied AI, with open-source collaboration at the center.
        </p>
      </div>
    </div>
  </section>

  <section class="team-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Team"
        title="The people building ArchUnit."
        copy="A small, multidisciplinary team focused on one practical outcome: keeping architectural intent close to the code."
      />
      <div class="core-team">
        {team.map((member) => (
          <article class="team-card">
            <a class="team-card__profile" href={'/team/' + member.slug + '/'}>
              <img
                src={member.photoUrl}
                alt={member.name}
                width="480"
                height="480"
                loading="lazy"
              />
              <div class="team-card__body">
                <p class="eyebrow">{member.role}</p>
                <h2>{member.name}</h2>
                <p>{member.bio}</p>
                <span class="team-card__profile-cta">View profile →</span>
              </div>
            </a>
            <div class="team-card__links">
              <a href={member.linkedinUrl} target="_blank" rel="noreferrer">
                LinkedIn ↗
              </a>
              {member.githubUrl && (
                <a href={member.githubUrl} target="_blank" rel="noreferrer">
                  GitHub ↗
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="origin-section">
    <div class="origin-grid shell">
      <div>
        <p class="eyebrow">Origin story</p>
        <h2>A missing TypeScript guardrail became a family.</h2>
      </div>
      <div class="origin-copy">
        <p>
          ArchUnit started with a concrete problem. While working as a consultant, Lukas needed an
          architecture-testing framework for TypeScript with the practical depth of ArchUnit in the
          Java ecosystem. The available options did not fully fit the project, so he began building
          ArchUnitTS in his spare time.
        </p>
        <p>
          Contributors joined, enterprise projects brought new requirements, and the original
          dependency rules grew into metrics, diagrams, reports, and test-runner integrations. The
          same idea then moved into Python, .NET, Ruby, Rust, Zig, Go, Java, and PHP.
        </p>
        <p>
          Each implementation respects its own language. What connects them is the belief that an
          architecture decision becomes more useful when the test suite can prove it after every
          change.
        </p>
        <a class="text-link" href="/blog/why-archunitts-exists/">
          Read the full project story →
        </a>
      </div>
    </div>
  </section>

  <section class="contributors-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Every contribution counts"
        title="The wider contributor community."
        copy="Documentation, fixes, examples, features, and thoughtful feedback all move an open-source project forward."
      />
      <div class="all-contributors">
        {contributors.map((contributor) => (
          <a
            class="contributor-chip"
            href={contributor.profileUrl}
            target="_blank"
            rel="noreferrer"
          >
            <img src={contributor.avatarUrl} alt="" width="34" height="34" loading="lazy" />
            <span>@{contributor.login}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="shell">
      <h2>
        There is room for your <em>perspective.</em>
      </h2>
      <p>
        Pick an ecosystem you know, explore the issues, and help architecture tests feel clearer,
        faster, and more native to that community.
      </p>
      <a
        class="button button--lime"
        href="https://github.com/LukasNiessen"
        target="_blank"
        rel="noreferrer"
      >
        Find a repository ↗
      </a>
    </div>
  </section>
</BaseLayout>
