---
import type { ProjectLogo } from '@data/projects';

interface Props {
  monogram: string;
  name: string;
  accent: string;
  accentSoft: string;
  size?: 'small' | 'medium' | 'large';
  logo?: ProjectLogo | undefined;
}

const { monogram, name, accent, accentSoft, size = 'medium', logo } = Astro.props;
const style = '--mark-accent:' + accent + ';--mark-soft:' + accentSoft;
const logoSources: Record<ProjectLogo, string> = {
  typescript: '/logos/archunitts.png',
  python: '/logos/archunitpython.png',
  go: '/logos/archunitgo.jpg',
};
---

<span
  class:list={['project-mark', 'project-mark--' + size, { 'project-mark--image': logo }]}
  style={style}
  aria-hidden="true"
>
  {logo ? (
    <img src={logoSources[logo]} alt="" width="96" height="96" loading="lazy" />
  ) : (
    <span>{monogram}</span>
  )}
  <span class="sr-only">{name}</span>
</span>
