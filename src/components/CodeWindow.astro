---
import { codeToHtml } from 'shiki';
import CopyIcon from './CopyIcon.astro';

interface Props {
  code: string;
  filename: string;
  language?: string;
  copy?: boolean;
}

const { code, filename, language = '', copy = false } = Astro.props;
let highlighted: string;
try {
  highlighted = await codeToHtml(code, {
    lang: language || 'text',
    theme: 'github-dark',
  });
} catch {
  const escaped = code.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
  highlighted = '<pre><code>' + escaped + '</code></pre>';
}
---

<div class="code-window" data-code-window>
  <div class="code-window__bar">
    <span class="window-dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="code-window__filename">{filename}</span>
    {copy && (
      <button class="copy-button" type="button" data-copy={code} aria-label="Copy code">
        <CopyIcon />
        <span data-copy-label>Copy</span>
      </button>
    )}
  </div>
  <div class="code-window__body" set:html={highlighted} />
</div>

{copy && <script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((copyButton) => {
    if (copyButton.dataset.copyBound === 'true') return;
    copyButton.dataset.copyBound = 'true';
    copyButton.addEventListener('click', async () => {
      const value = copyButton.dataset.copy;
      if (!value) return;
      await navigator.clipboard.writeText(value);
      const label = copyButton.querySelector<HTMLElement>('[data-copy-label]');
      if (!label) return;
      label.textContent = 'Copied';
      window.setTimeout(() => {
        label.textContent = 'Copy';
      }, 1600);
    });
  });
</script>}
