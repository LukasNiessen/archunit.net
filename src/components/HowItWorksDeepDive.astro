---
import CodeWindow from './CodeWindow.astro';
import InlineCode from './InlineCode.astro';

const pythonDiscovery = [
  '# os.walk yields one directory at a time: its path,',
  '# mutable child-directory names, and the file names inside it.',
  'for dirpath, dirnames, filenames in os.walk(root):',
  '    # Slice assignment prunes folders before os.walk enters them.',
  '    dirnames[:] = [',
  '        name for name in dirnames',
  '        if not _should_exclude_path(',
  '            os.path.join(dirpath, name), root, exclude, is_dir=True',
  '        )',
  '    ]',
  '    for filename in filenames:',
  '        full_path = os.path.join(dirpath, filename)',
  '        if filename.endswith(".py") and not _should_exclude_path(',
  '            full_path, root, exclude, is_dir=False',
  '        ):',
  '            # Keep one stable absolute identity per Python source file.',
  '            py_files.append(os.path.abspath(full_path))',
].join('\n');

const pythonAst = [
  'def _extract_located_imports(file_path):',
  '    # Decode the complete .py file into one Python string.',
  '    try:',
  '        with open(file_path, "r", encoding="utf-8", errors="replace") as file:',
  '            source = file.read()',
  '    except (OSError, IOError):',
  '        return []',
  '',
  '    # filename labels parser diagnostics; ast.parse does not read the file.',
  '    try:',
  '        tree = ast.parse(source, filename=file_path)',
  '    except SyntaxError:',
  '        return []',
  '',
  '    imports = []',
  '    type_checking_ranges = _find_type_checking_ranges(tree)',
  '    conditional_import_ranges = _find_conditional_import_ranges(tree)',
  '    # Walk descendants because imports may be nested in functions or try blocks.',
  '    for node in ast.walk(tree):',
  '        if isinstance(node, ast.Import):',
  '            syntax_kind = ImportKind.IMPORT',
  '            kind = _classify_import(',
  '                node, syntax_kind, type_checking_ranges, conditional_import_ranges',
  '            )',
  '            for alias in node.names:',
  '                imports.append(_LocatedImport(',
  '                    alias.name, kind, node.lineno, syntax_kind',
  '                ))',
  '        elif isinstance(node, ast.ImportFrom):',
  '            # Relative and from-import nodes follow the same record pipeline.',
  '            ...',
  '        elif isinstance(node, ast.Call):',
  '            # Only literal importlib/__import__ module names can be recorded.',
  '            ...',
  '    return imports',
].join('\n');

const pythonResolution = [
  '# One located import can resolve to multiple namespace-package targets.',
  'for resolved, is_external in _resolve_import_targets(',
  '    located_import, file_path, project_path',
  '):',
  '    # Do not duplicate the self-edge already used to preserve the node.',
  '    if resolved and resolved != _normalize(file_path):',
  '        # An internal target must belong to the discovered Python file set.',
  '        if not is_external and resolved not in normalized_py_file_set:',
  '            continue',
  '',
  '        edges.append(Edge(',
  '            source=_normalize(file_path),',
  '            target=resolved,',
  '            external=is_external,',
  '            import_kinds=_edge_import_kinds(located_import),',
  '        ))',
  '',
  '# Equal source/target pairs become one edge with combined import kinds.',
  'return _merge_edges(edges)',
].join('\n');

const pythonRule = [
  '# Build a lazy architecture sentence. No project scan happens yet.',
  'rule = (',
  '    project_files("src/")',
  '    # Subject: only files under a UI folder.',
  '    .in_folder("**/ui/**")',
  '    # Mood and predicate: forbid matching dependency edges.',
  '    .should_not()',
  '    .depend_on_files()',
  '    # Object: dependency targets under a DB folder.',
  '    .in_folder("**/db/**")',
  '    .because("UI code must not own persistence")',
  ')',
  '',
  '# The assertion terminal extracts, evaluates, and fails on findings.',
  'assert_passes(rule)',
].join('\n');

const typescriptRule = [
  '// Build the same lazy sentence with TypeScript naming.',
  'const rule = projectFiles("tsconfig.json")',
  "  .inFolder('src/ui')",
  '  .shouldNot()',
  '  .dependOnFiles()',
  "  .inFolder('src/db');",
  '',
  '// check() triggers extraction and returns structured violations.',
  'const violations = await rule.check({',
  '  clearCache: true,',
  "  logging: { enabled: true, level: 'debug' },",
  '});',
].join('\n');

const pythonEvaluation = [
  '# DependOnFileCondition.check(): extract, project, then delegate.',
  'graph = extract_graph(self._project_path, options=options)',
  'edges = project_edges(graph, per_internal_edge())',
  'return gather_depend_on_file_violations(',
  '    edges,',
  '    self._subject_filters,',
  '    self._object_filters,',
  '    self._is_negated,',
  ')',
  '',
  '# gather_depend_on_file_violations(): inspect each projected edge.',
  'for edge in edges:',
  '    # All subject filters must accept the importing file.',
  '    source_matches = all(',
  '        matches_pattern(edge.source_label, f) for f in subject_filters',
  '    )',
  '    if not source_matches:',
  '        continue',
  '',
  '    # All object filters must accept the resolved target file.',
  '    target_matches = all(',
  '        matches_pattern(edge.target_label, f) for f in object_filters',
  '    )',
  '    # For should_not(), a matching source and target is forbidden.',
  '    if is_negated and target_matches:',
  '        violations.append(ViolatingFileDependency(',
  '            dependency=edge, is_negated=True',
  '        ))',
].join('\n');

const assertionBoundary = [
  'def assert_passes(checkable, options=None):',
  '    # Keep evaluation as data until the test boundary.',
  '    violations = checkable.check(options)',
  '    if violations:',
  '        # Carry the architectural reason into the failure message.',
  '        because = getattr(checkable, "because_reason", None)',
  '        raise AssertionError(',
  '            format_violations(violations, because=because)',
  '        )',
].join('\n');

const realTrace = [
  { level: 'info', text: '[INFO] Starting architecture rule check: Dependency check: 1 filters' },
  {
    level: 'info',
    text: '[INFO] Using TypeScript config file: <repo>/test/layered-arch/layered-arch-1/tsconfig.json',
  },
  { level: 'info', text: '[INFO] TypeScript program created with 199 source files' },
  { level: 'debug', text: '[DEBUG] Project source files: 2' },
  { level: 'debug', text: '[DEBUG] Node modules files: 197' },
  { level: 'debug', text: '[DEBUG] Processing file 1/2: src/db/db.ts' },
  { level: 'debug', text: '[DEBUG] Processing file 2/2: src/ui/ui.ts' },
  { level: 'debug', text: '[DEBUG] Processing import: "../db/db" in src/ui/ui.ts' },
  { level: 'debug', text: '[DEBUG] Resolved "../db/db" to: src/db/db.ts (external: false)' },
  { level: 'info', text: '[INFO] Import analysis completed:' },
  { level: 'info', text: '[INFO]   - Total edges found: 132' },
  { level: 'info', text: '[INFO]   - Files processed: 2' },
  { level: 'info', text: '[INFO] Graph extraction completed with 132 edges' },
  { level: 'debug', text: '[DEBUG] Analyzing dependencies across 124 edges' },
  { level: 'info', text: '[INFO] Found edge: From src/ui/ui.ts to src/db/db.ts' },
  {
    level: 'warn',
    text: '[WARN] Violation found: Dependency violation: {"dependency":{"sourceLabel":"src/ui/ui.ts","targetLabel":"src/db/db.ts","cumulatedEdges":[{"source":"src/ui/ui.ts","target":"src/db/db.ts","external":false,"importKinds":["value","named"]}]},"isNegated":true}',
  },
  {
    level: 'warn',
    text: '[WARN] Completed architecture rule check: Dependency check: 1 filters (1 violations)',
  },
];

const chapters = [
  ['mental-model', '01', 'Mental model'],
  ['discover-parse', '02', 'Discover and parse'],
  ['resolve-graph', '03', 'Resolve and graph'],
  ['fluent-rule', '04', 'Fluent rule'],
  ['evaluate', '05', 'Evaluate'],
  ['algorithms', '06', 'Algorithms'],
  ['feedback', '07', 'Feedback'],
];
---

<div class="deep-how" data-deep-how>
  <section class="deep-hero" id="mental-model">
    <div class="deep-shell deep-hero__grid">
      <div>
        <p class="deep-kicker">How ArchUnit works, from first principles</p>
        <h1>Source code becomes a graph. Rules become questions.</h1>
      </div>
      <div class="deep-hero__copy">
        <p>
          ArchUnit does not run your application and watch requests move through it. It inspects
          source structure, resolves dependency evidence, builds a directed graph, and evaluates a
          precise architectural sentence against that graph.
        </p>
        <p>
          The language adapter changes. Python reads Python syntax; TypeScript asks the TypeScript
          compiler. The reasoning after extraction stays recognizable.
        </p>
      </div>
    </div>
    <div class="deep-shell deep-equation" aria-label="The ArchUnit processing model">
      <span>source text</span>
      <b>→</b>
      <span>syntax</span>
      <b>→</b>
      <span>resolved imports</span>
      <b>→</b>
      <span>directed graph</span>
      <b>→</b>
      <span>rule projection</span>
      <b>→</b>
      <span>violations</span>
    </div>
  </section>

  <nav class="deep-chapters" aria-label="How ArchUnit Works chapters">
    <div class="deep-shell">
      {chapters.map(([id, number, label]) => (
        <a href={'#' + id} data-chapter-link={id}>
          <span>{number}</span>
          {label}
        </a>
      ))}
    </div>
  </nav>

  <section class="deep-section deep-principles">
    <div class="deep-shell">
      <div class="deep-section-heading">
        <p class="deep-kicker">The smallest useful model</p>
        <h2>Four terms are enough to follow the walkthrough.</h2>
        <p>
          These terms give us a shared vocabulary. The later chapters show the implementation
          details, language adaptations, projections, algorithms, and test integration behind them.
        </p>
      </div>
      <div class="principle-grid">
        <article>
          <span>01</span>
          <h3>Node</h3>
          <p>
            A stable identity for something architecture rules can talk about. File rules primarily
            use source files such as <InlineCode code="src/ui/ui.ts" language="typescript" />.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Directed edge</h3>
          <p>
            An arrow from the depender to the dependency. If A imports B, the graph records
            <InlineCode code="A → B" language="text" />. Direction is architectural evidence.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Projection</h3>
          <p>
            A focused view of the raw graph. The same edges can be viewed as files, folders, layers,
            slices, internal dependencies, external modules, or cycle paths.
          </p>
        </article>
        <article>
          <span>04</span>
          <h3>Violation</h3>
          <p>
            Structured evidence that the projected graph disagrees with a rule. It remains data
            until a test adapter decides to raise, fail, print, or render it.
          </p>
        </article>
      </div>
      <aside class="not-dag" aria-label="A note about cycles">
        <strong>Directed does not mean acyclic.</strong>
        <p>
          A DAG is a directed acyclic graph. ArchUnit does not assume the project graph is a DAG:
          real code can contain return paths, and detecting those cycles is one of the library's
          jobs.
        </p>
      </aside>
    </div>
  </section>

  <section class="deep-section deep-discovery" id="discover-parse">
    <div class="deep-shell">
      <div class="deep-section-heading deep-section-heading--wide">
        <p class="deep-kicker">Chapter 02 / Discover and parse</p>
        <h2>Before a graph exists, the library must turn a project into trustworthy evidence.</h2>
        <p>
          Static analysis means inspecting program text and its structure without executing the
          application. It can prove relationships represented by supported syntax. It does not guess
          values that exist only at runtime.
        </p>
      </div>

      <div class="definition-band">
        <article>
          <span>Step 1 / Discover files</span>
          <h3>
            <InlineCode code="os.walk()" language="python" /> finds candidate files.
          </h3>
          <p>
            <InlineCode code="os" language="python" /> is Python's built-in operating-system module.
            <InlineCode code="os.walk(root)" language="python" /> recursively yields a directory
            path, its child-directory names, and its filenames. ArchUnitPython mutates
            <InlineCode code="dirnames[:]" language="python" /> to stop recursion into excluded
            environments, caches, builds, and paths from{' '}
            <InlineCode code=".archignore" language="text" />. The slice updates the same list
            object that <InlineCode code="os.walk()" language="python" /> will consult before
            descending; rebinding <InlineCode code="dirnames" language="python" /> would not prune
            traversal.
          </p>
          <aside class="ts-analog">
            <span>TypeScript equivalent</span>
            <p>
              <InlineCode code="ts.parseJsonConfigFileContent()" language="typescript" /> expands
              the project's <InlineCode code="include" language="json" />,
              <InlineCode code="exclude" language="json" />, and
              <InlineCode code="files" language="json" /> rules into
              <InlineCode code="parsed.fileNames" language="typescript" />. The compiler config,
              rather than a general directory walk, decides the input set.
            </p>
          </aside>
        </article>
        <article>
          <span>Step 2 / Read and parse</span>
          <h3>
            <InlineCode code="ast.parse()" language="python" /> turns text into structure.
          </h3>
          <p>
            AST stands for Abstract Syntax Tree. Python's built-in{' '}
            <InlineCode code="ast" language="python" />
            module parses characters into nodes such as{' '}
            <InlineCode code="Import" language="python" />,
            <InlineCode code="ImportFrom" language="python" />, and{' '}
            <InlineCode code="Call" language="python" />. Parsing does not import the module and
            does not execute its top-level code. Immediately before parsing,
            <InlineCode code="file.read()" language="python" /> reads the complete file through a
            UTF-8 decoder into one Python <InlineCode code="str" language="python" />. The
            <InlineCode code='errors="replace"' language="python" /> option substitutes a marker for
            malformed byte sequences instead of aborting the project scan.
          </p>
          <aside class="ts-analog">
            <span>TypeScript equivalent</span>
            <p>
              <InlineCode code="ts.createProgram()" language="typescript" /> creates compiler
              <InlineCode code="SourceFile" language="typescript" /> trees for the configured
              project. Like Python's AST, these trees represent syntax without running the app.
            </p>
          </aside>
        </article>
        <article>
          <span>Step 3 / Walk syntax</span>
          <h3>
            <InlineCode code="ast.walk()" language="python" /> visits every descendant.
          </h3>
          <p>
            ArchUnitPython classifies ordinary imports, relative imports, imports under
            <InlineCode code="TYPE_CHECKING" language="python" />, optional imports inside
            <InlineCode code="try/except ImportError" language="python" />, and literal calls to
            <InlineCode code="importlib.import_module()" language="python" /> or
            <InlineCode code="__import__()" language="python" />.
          </p>
          <aside class="ts-analog">
            <span>TypeScript equivalent</span>
            <p>
              In this extractor, <InlineCode code="ts.forEachChild()" language="typescript" />
              visits the direct children of each
              <InlineCode code="SourceFile" language="typescript" />. The predicate
              <InlineCode code="ts.isImportDeclaration()" language="typescript" /> selects supported
              top-level imports; it is not the recursive walk used by Python here.
            </p>
          </aside>
        </article>
      </div>

      <div class="deep-code-pair deep-code-pair--foundations">
        <div class="deep-code">
          <p>
            <span>Python</span> Source-faithful file-discovery path with teaching comments
          </p>
          <CodeWindow code={pythonDiscovery} filename="extract_graph.py" language="python" copy />
        </div>
        <div class="deep-code">
          <p>
            <span>Python</span> Abridged source: error handling, parsing, and one import branch
          </p>
          <CodeWindow
            code={pythonAst}
            filename="extract_graph.py · abridged source"
            language="python"
            copy
          />
        </div>
      </div>

      <div class="memory-checkpoint" aria-label="Values produced by Python parsing">
        <div>
          <span>After reading</span>
          <strong>
            <InlineCode code="source: str" language="python" />
          </strong>
          <p>
            The decoded characters from one complete <InlineCode code=".py" language="text" /> file.
          </p>
        </div>
        <b aria-hidden="true">→</b>
        <div>
          <span>After parsing</span>
          <strong>
            <InlineCode code="tree: ast.Module" language="python" />
          </strong>
          <p>A root node whose descendants mirror the file's syntax and source locations.</p>
        </div>
        <b aria-hidden="true">→</b>
        <div>
          <span>After walking</span>
          <strong>located import evidence</strong>
          <p>
            <InlineCode code="_LocatedImport" language="python" /> stores module text, syntax and
            resolution kinds, line number, fallbacks, and aliases. The outer file loop separately
            supplies <InlineCode code="file_path" language="python" /> as the source identity.
          </p>
        </div>
      </div>

      <div class="ast-visual" aria-label="A Python import becoming a located import record">
        <div>
          <span>Source statement</span>
          <InlineCode code="from ..db import session" language="python" />
        </div>
        <b aria-hidden="true">→</b>
        <div>
          <span>Python AST node</span>
          <InlineCode code='ImportFrom(module="db", level=2)' language="python" />
        </div>
        <b aria-hidden="true">→</b>
        <div>
          <span>ArchUnitPython record</span>
          <InlineCode
            code='_LocatedImport(module_name="..db", import_kind=RELATIVE_IMPORT, line_number=12, resolution_kind=RELATIVE_IMPORT, aliases=("session",))'
            language="python"
          />
        </div>
      </div>

      <aside class="analysis-limit">
        <strong>Static evidence can be incomplete.</strong>
        <p>
          If a file cannot be read or Python raises
          <InlineCode code="SyntaxError" language="python" />, this extractor returns no imports for
          that file and continues. Computed dynamic module names are also skipped because their
          target does not exist until runtime. The walkthrough describes supported evidence, not a
          promise to infer behavior that source text cannot show.
        </p>
      </aside>

      <aside class="language-analogy">
        <div>
          <p class="deep-kicker">The same stage in TypeScript</p>
          <h3>Let the compiler define the project boundary.</h3>
        </div>
        <p>
          ArchUnitTS reads <InlineCode code="tsconfig.json" language="json" /> with
          <InlineCode code="ts.readConfigFile()" language="typescript" />, expands the configured
          input set with <InlineCode code="ts.parseJsonConfigFileContent()" language="typescript" />
          , and creates a coherent compiler view with
          <InlineCode code="ts.createProgram()" language="typescript" />. This is the TypeScript
          analogue of discovering files and parsing their syntax. It also preserves path aliases,
          JSX settings, and recursively loaded project references that a plain directory scan would
          miss. ArchUnitTS then calls
          <InlineCode code="program.getSourceFiles()" language="typescript" /> and checks top-level
          <InlineCode code="ImportDeclaration" language="typescript" /> nodes exposed by
          <InlineCode code="ts.forEachChild()" language="typescript" />.
        </p>
      </aside>
    </div>
  </section>

  <section class="deep-section deep-lab-section" id="resolve-graph">
    <div class="deep-shell">
      <div class="deep-section-heading deep-section-heading--wide">
        <p class="deep-kicker">Chapter 03 / Resolve and build the graph</p>
        <h2>An import statement is evidence. Resolution turns it into an edge.</h2>
        <p>
          The text <InlineCode code="..db" language="python" /> is not yet a target. It must be
          interpreted from the importing file under the project's language rules. Only then can the
          graph say that <InlineCode code="src/ui/view.py" language="python" /> depends on
          <InlineCode code="src/db.py" language="python" />.
        </p>
      </div>

      <div class="python-edge-story" aria-label="One Python import becoming a graph edge">
        <article>
          <span>1 / Locate</span>
          <strong>
            <InlineCode code="src/ui/view.py" language="python" />
          </strong>
          <p>
            The outer file loop supplies the source identity. Inside that file, the parser finds
            <InlineCode code="from ..db import database" language="python" /> on line 12.
          </p>
        </article>
        <article>
          <span>2 / Classify</span>
          <strong>
            <InlineCode code="_LocatedImport" language="python" />
          </strong>
          <p>
            The record keeps <InlineCode code='module_name="..db"' language="python" />, line 12,
            alias <InlineCode code="database" language="python" />, and two kinds. The
            <InlineCode code="import_kind" language="python" /> describes context, while
            <InlineCode code="resolution_kind" language="python" /> preserves relative-path
            semantics even if the import is also conditional or type-only.
          </p>
        </article>
        <article>
          <span>3 / Resolve</span>
          <strong>
            <InlineCode code="src/db.py" language="python" />
          </strong>
          <p>
            Leading dots move from the importing package. The resolver tests a module file and then
            a package <InlineCode code="__init__.py" language="python" />. A path inside the
            discovered project becomes an internal target.
          </p>
        </article>
        <article>
          <span>4 / Record</span>
          <strong>
            <InlineCode code="Edge(view.py → db.py)" language="python" />
          </strong>
          <p>
            Only after resolution can ArchUnitPython store the importing path, resolved target,
            <InlineCode code="external=False" language="python" />, and the import kinds as one
            directed evidence record.
          </p>
        </article>
      </div>

      <div class="resolution-detail">
        <div>
          <p class="deep-kicker">Python resolution in source</p>
          <h3>Resolve against files that actually exist.</h3>
          <p>
            Relative imports move from the source directory. Absolute imports are tested from the
            project root and its parent. One from-import can yield multiple namespace-package alias
            targets, so <InlineCode code="_resolve_import_targets()" language="python" /> returns a
            list rather than one answer.
          </p>
          <p>
            The excerpt is abridged only around its enclosing loops. Every shown branch and record
            field comes from the current extractor.
          </p>
        </div>
        <div class="deep-code">
          <CodeWindow
            code={pythonResolution}
            filename="extract_graph.py · abridged source"
            language="python"
            copy
          />
        </div>
      </div>

      <aside class="language-analogy language-analogy--compact">
        <div>
          <p class="deep-kicker">The same stage in TypeScript</p>
          <h3>Ask the configured compiler host to resolve the target.</h3>
        </div>
        <p>
          <InlineCode code="ts.resolveModuleName()" language="typescript" /> receives the import
          text, importing filename, compiler options, and compiler host. Its answer accounts for
          aliases, extension rules, package metadata, and referenced configurations. ArchUnitTS
          normalizes the resolved filename relative to the configuration root, then records the same
          source, target, external flag, and import-kind evidence required by the graph model.
        </p>
      </aside>

      <div class="trace-intro">
        <p class="deep-kicker">Verified execution evidence</p>
        <h3>The equivalent TypeScript path is observable in a real debug run.</h3>
        <p>
          ArchUnitPython does not currently emit an equivalent edge-by-edge debug trace. The lab
          therefore uses ArchUnitTS to make discovery, compiler setup, import resolution,
          projection, and evaluation visible. The trace below was captured from the repository
          fixture; it is not fabricated output.
        </p>
      </div>

      <div class="evidence-lab" data-evidence-lab>
        <div class="ide-frame">
          <div class="ide-titlebar">
            <span class="window-dots" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <strong>real fixture / ArchUnitTS</strong>
            <button type="button" data-run-trace>
              Replay trace
            </button>
          </div>
          <div class="ide-body">
            <aside aria-label="Fixture files">
              <span>layered-arch-1</span>
              <span>src/</span>
              <button type="button" class="active">
                ui/ui.ts
              </button>
              <span>db/db.ts</span>
              <span>tsconfig.json</span>
            </aside>
            <div class="ide-editor code-window">
              <div class="ide-tab">ui.ts</div>
              <pre aria-label="The real TypeScript fixture source"><code><span class="token-comment">// This import is a violation!</span>
<span class="token-keyword">import</span> <span class="token-punctuation">&#123;</span> startDb <span class="token-punctuation">&#125;</span> <span class="token-keyword">from</span> <span class="token-string">'../db/db'</span>;

