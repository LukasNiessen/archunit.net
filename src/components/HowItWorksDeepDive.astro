    </div>
  </section>

  <section class="deep-section deep-evaluation-section" id="evaluate">
    <div class="deep-shell">
      <div class="deep-section-heading deep-section-heading--wide">
        <p class="deep-kicker">Chapter 05 / Evaluate the rule</p>
        <h2>The evaluator is a small machine over an in-memory graph.</h2>
        <p>
          Language-specific parsing is finished. From here the rule terminal projects graph edges,
          applies selectors, and creates typed violations. The negative dependency example can be
          described without knowing Python or TypeScript syntax.
        </p>
      </div>

      <div class="evaluation-machine">
        <div class="evaluation-flow">
          <article>
            <span>1</span>
            <strong>Extract</strong>
            <p>Obtain the cached or newly built raw graph.</p>
          </article>
          <article>
            <span>2</span>
            <strong>Project</strong>
            <p>
              Create stable source and target labels for this rule. Python file-dependency rules
              keep internal edges; TypeScript uses{' '}
              <InlineCode code="perEdge()" language="typescript" />
              and retains external and self-edges.
            </p>
          </article>
          <article>
            <span>3</span>
            <strong>Select subject</strong>
            <p>Does the source label match every UI filter?</p>
          </article>
          <article>
            <span>4</span>
            <strong>Select object</strong>
            <p>Does the target label match every DB filter?</p>
          </article>
          <article>
            <span>5</span>
            <strong>Judge mood</strong>
            <p>
              For <InlineCode code="should_not()" language="python" />, a double match is a
              violation.
            </p>
          </article>
          <article>
            <span>6</span>
            <strong>Return evidence</strong>
            <p>Keep the projected edge and its underlying raw imports.</p>
          </article>
        </div>
        <div class="evaluation-code-stack">
          <div class="deep-code">
            <p>
              <span>Python</span> Extract, project internal edges, then evaluate
            </p>
            <CodeWindow
              code={pythonEvaluation}
              filename="files.py + depend_on_files.py"
              language="python"
              copy
            />
          </div>
          <div class="deep-code">
            <p>
              <span>TypeScript</span> Extract, project per edge, guard empty selections, then
              evaluate
            </p>
            <CodeWindow
              code={typescriptEvaluation}
              filename="files.ts + depend-on-files.ts · abridged"
              language="typescript"
              copy
            />
          </div>
        </div>
      </div>

      <div class="evaluation-notes">
        <article>
          <span>
            <InlineCode code="all(...)" language="python" />
          </span>
          <p>
            This is logical AND across every configured filter. A source or target must satisfy all
            of them, not merely one.
          </p>
        </article>
        <article>
          <span>
            <InlineCode code="EmptyTestViolation" language="typescript" />
          </span>
          <p>
            TypeScript reports an empty-test violation when no source or target candidate matches,
            unless <InlineCode code="allowEmptyTests" language="typescript" /> is enabled. This
            prevents a misspelled path from passing silently.
          </p>
        </article>
        <article>
          <span>
            <InlineCode code="continue" language="python" />
          </span>
          <p>
            A nonmatching source rejects the current edge early and advances the loop to the next
            candidate.
          </p>
        </article>
        <article>
          <span>
            <InlineCode code="matches_pattern()" language="python" />
          </span>
          <p>
            The matcher compares the normalized projected path label with a fluent API filter such
            as <InlineCode code="**/ui/**" language="text" />.
          </p>
        </article>
      </div>

      <div class="evaluation-example">
        <div class="eval-row eval-row--head">
          <span>source</span>
          <span>target</span>
          <span>subject match</span>
          <span>object match</span>
          <span>result</span>
        </div>
        <div class="eval-row">
          <strong>src/ui/view.py</strong>
          <strong>src/db.py</strong>
          <span>yes</span>
          <span>yes</span>
          <b>violation</b>
        </div>
        <div class="eval-row">
          <strong>src/ui/view.py</strong>
          <strong>src/ui/presenter.py</strong>
          <span>yes</span>
          <span>no</span>
          <em>ignored</em>
        </div>
        <div class="eval-row">
          <strong>src/core/config.py</strong>
          <strong>src/db.py</strong>
          <span>no</span>
          <span>yes</span>
          <em>ignored</em>
        </div>
      </div>

      <div class="empty-test-note">
        <div>
          <p class="deep-kicker">Zero matches need an explicit policy</p>
          <h3>A green test that inspected nothing is dangerous.</h3>
        </div>
        <p>
          Empty-selection handling is terminal-specific. Python's cycle and some pattern terminals
          call <InlineCode code="_check_empty_test()" language="python" /> and return an
          <InlineCode code="EmptyTestViolation" language="python" /> unless
          <InlineCode code="allow_empty_tests" language="python" /> is enabled. The Python
          <InlineCode code="DependOnFileCondition" language="python" /> shown above does not
          currently add that guard. This is concrete terminal behavior, not a magical property of
          the graph, and callers should scope dependency rules deliberately. TypeScript's dependency
          condition checks both the source and target selections and returns an
          <InlineCode code="EmptyTestViolation" language="typescript" /> by default when either is
          empty.
        </p>
      </div>

      <div class="stage-output">
        <span>Output of evaluation</span>
        <p>
          Python returns a <InlineCode code="list[Violation]" language="python" />; TypeScript
          resolves a <InlineCode code={'Promise<Violation[]>'} language="typescript" />. Each
          dependency finding keeps the projected edge, its accumulated raw edges, and whether the
          rule was negated. Nothing has failed the test runner yet.
        </p>
      </div>
    </div>
  </section>

  <section class="deep-section deep-algorithm-section" id="algorithms">
    <div class="deep-shell">
      <div class="deep-section-heading deep-section-heading--wide">
        <p class="deep-kicker">Chapter 06 / Algorithms</p>
        <h2>Different architecture questions require different graph operations.</h2>
        <p>
          A forbidden direct dependency is local: inspect candidate edges. A cycle is global: find a
          path that eventually returns to its starting node. ArchUnit chooses the operation that
          matches the meaning of the rule.
        </p>
      </div>

      <div class="algorithm-grid">
        <article>
          <span>Direct dependency</span>
          <h3>Filter edges.</h3>
          <p>
            Project to the relevant edge type, match source labels, match target labels, and emit
            one finding for every forbidden relationship.
          </p>
          <strong>Work grows with inspected edges.</strong>
        </article>
        <article>
          <span>Cycle detection, phase one</span>
          <h3>Tarjan finds strongly connected components.</h3>
          <p>
            A strongly connected component is a region where every node can reach every other node.
            Tarjan identifies those regions in linear time over nodes and edges.
          </p>
          <strong>Discard regions that cannot contain a cycle.</strong>
        </article>
        <article>
          <span>Cycle detection, phase two</span>
          <h3>Johnson enumerates simple cycles.</h3>
          <p>
            Johnson's algorithm runs inside the relevant components and returns complete cycle paths
            without repeating vertices inside one path.
          </p>
          <strong>Work also depends on how many cycles must be reported.</strong>
        </article>
      </div>

      <div
        class="algorithm-visual"
        aria-label="Cycle A to B to C and back to A, with isolated node D"
      >
        <div>
          <span>A</span>
          <small>component 1</small>
        </div>
        <i>→</i>
        <div>
          <span>B</span>
          <small>component 1</small>
        </div>
        <i>→</i>
        <div>
          <span>C</span>
          <small>component 1</small>
        </div>
        <i class="algorithm-return" aria-label="return edge from C to A">
          ↩ A
        </i>
        <div class="algorithm-isolated">
          <span>D</span>
          <small>acyclic</small>
        </div>
        <p>
          Tarjan keeps A, B, C together. Johnson reports A → B → C → A. D is eliminated from cycle
          enumeration.
        </p>
      </div>
    </div>
  </section>

  <section class="deep-section deep-feedback-section" id="feedback">
    <div class="deep-shell">
      <div class="deep-section-heading deep-section-heading--wide">
        <p class="deep-kicker">Chapter 07 / Cross the test boundary last</p>
        <h2>A rule returns data. An assertion turns that data into a failed test.</h2>
        <p>
          Separating evaluation from presentation makes the same findings usable by pytest, Jest,
          Vitest, CI logs, reports, and custom tools. It also keeps the core algorithms testable
          without a test runner.
        </p>
      </div>

      <div class="assertion-code-pair">
        <div class="deep-code">
          <p>
            <span>Python</span> Abridged source from the test assertion adapter
          </p>
          <CodeWindow
            code={assertionBoundary}
            filename="testing/assertion.py"
            language="python"
            copy
          />
        </div>
        <div class="deep-code">
          <p>
            <span>TypeScript</span> The shared Jest and Vitest matcher boundary
          </p>
          <CodeWindow
            code={typescriptAssertionBoundary}
            filename="jest-adapter.ts · equivalent path in Vitest"
            language="typescript"
            copy
          />
        </div>
      </div>
      <div class="assertion-steps assertion-steps--wide">
        <article>
          <span>01</span>
          <p>
            Python <InlineCode code="checkable.check(options)" language="python" /> and TypeScript{' '}
            <InlineCode code="checkable.check(options)" language="typescript" /> return typed
            violation data rather than failing a test themselves.
          </p>
        </article>
        <article>
          <span>02</span>
          <p>
            With no findings, Python returns normally. TypeScript's matcher produces a result with
            <InlineCode code="pass: true" language="typescript" />.
          </p>
        </article>
        <article>
          <span>03</span>
          <p>
            With findings, Python formats concrete details and the optional
            <InlineCode code="because_reason" language="python" />. TypeScript maps each finding
            through <InlineCode code="ViolationFactory.from()" language="typescript" /> and keeps
            every accumulated raw edge for diagnostics.
          </p>
        </article>
        <article>
          <span>04</span>
          <p>
            Python raises <InlineCode code="AssertionError" language="python" />. TypeScript returns
            <InlineCode code="{ pass, message }" language="typescript" />; Jest or Vitest turns
            <InlineCode code="pass: false" language="typescript" /> into the failed test.
          </p>
        </article>
      </div>

      <div class="stage-output">
        <span>Output at the test boundary</span>
        <p>
          No findings means a normal return. Findings become one formatted
          <InlineCode code="AssertionError" language="python" /> with concrete dependency evidence
          and the optional <InlineCode code="because_reason" language="python" />. TypeScript keeps
          the same separation and crosses the runner boundary through
          <InlineCode code="toPassAsync()" language="typescript" />.
        </p>
      </div>

      <div class="trust-boundary">
        <div>
          <span>What static analysis can support</span>
          <ul>
            <li>Supported import syntax and statically resolvable targets</li>
            <li>Dependency direction, cycles, layers, slices, and reachability over those edges</li>
            <li>Naming, placement, source counts, and supported static metrics</li>
          </ul>
        </div>
        <div>
          <span>What it must not invent</span>
          <ul>
            <li>Computed module names known only after runtime values exist</li>
            <li>Reflection, monkey patching, or container wiring without source evidence</li>
            <li>Whether a business boundary is a good architectural decision</li>
          </ul>
        </div>
      </div>

      <div class="deep-summary">
        <p class="deep-kicker">The complete machine</p>
        <h2>Discover. Parse. Resolve. Build. Project. Judge. Explain.</h2>
        <p>
          The parser is language-native. The graph is explicit. The rule is readable. The finding
          keeps its evidence. That is how an architectural intention becomes an ordinary test the
          team can run on every change.
        </p>
        <div>
          <a class="button button--lime" href="/#libraries">
            Choose a library
          </a>
          <a class="button button--ghost" href="/why-architecture-tests/">
            Why test architecture?
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-deep-how]');

  if (root) {
    const adapterPicker = root.querySelector<HTMLElement>('[data-adapter-picker]');
    const adapterTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-adapter-tab]'));
    const adapterPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-adapter-panel]'));
    const adapterStatus = root.querySelector<HTMLElement>('[data-adapter-status]');
    const validAdapters = new Set(adapterTabs.map((tab) => tab.dataset.adapterTab ?? ''));

    const selectAdapter = (adapterId: string, focusTab = false, persist = true) => {
      if (!validAdapters.has(adapterId)) return;
      adapterTabs.forEach((tab) => {
        const selected = tab.dataset.adapterTab === adapterId;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focusTab) tab.focus();
      });
      adapterPanels.forEach((panel) => {
        panel.hidden = panel.dataset.adapterPanel !== adapterId;
      });
      root.dataset.adapter = adapterId;
      const selectedTab = adapterTabs.find((tab) => tab.dataset.adapterTab === adapterId);
      const label = selectedTab?.childNodes[0]?.textContent?.trim() ?? adapterId;
      if (adapterStatus) adapterStatus.textContent = `${label} adapter selected.`;
      if (persist) {
        try {
          globalThis.localStorage.setItem('archunit-how-language', adapterId);
        } catch {
          // The selected tab still works when storage is unavailable.
        }
      }
    };

    let initialAdapter = 'python';
    const queryAdapter = new URL(globalThis.location.href).searchParams.get('language');
    try {
      const storedAdapter = globalThis.localStorage.getItem('archunit-how-language');
      if (storedAdapter && validAdapters.has(storedAdapter)) initialAdapter = storedAdapter;
    } catch {
      // Keep the Python default when storage is unavailable.
    }
    if (queryAdapter && validAdapters.has(queryAdapter)) initialAdapter = queryAdapter;

    adapterTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectAdapter(tab.dataset.adapterTab ?? 'python'));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % adapterTabs.length;
        else if (event.key === 'ArrowLeft') {
          nextIndex = (index - 1 + adapterTabs.length) % adapterTabs.length;
        } else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = adapterTabs.length - 1;
        else return;
        event.preventDefault();
        const nextId = adapterTabs[nextIndex]?.dataset.adapterTab;
        if (nextId) selectAdapter(nextId, true);
      });
    });
    selectAdapter(initialAdapter, false, false);
    adapterPicker?.removeAttribute('hidden');

    const lab = root.querySelector<HTMLElement>('[data-evidence-lab]');
    const runButton = lab?.querySelector<HTMLButtonElement>('[data-run-trace]');
    const showAllButton = lab?.querySelector<HTMLButtonElement>('[data-show-trace]');
    const logLines = Array.from(lab?.querySelectorAll<HTMLElement>('[data-log-line]') ?? []);
    const graph = lab?.querySelector<HTMLElement>('[data-lab-graph]');
    const logViewport = lab?.querySelector<HTMLElement>('[data-evidence-terminal] pre');
    const stepLabel = lab?.querySelector<HTMLElement>('[data-lab-step]');
    const traceStatus = lab?.querySelector<HTMLElement>('[data-trace-status]');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timers: number[] = [];
    let runId = 0;

    const clearTraceTimers = () => {
      runId += 1;
      timers.forEach((timer) => window.clearTimeout(timer));
      timers = [];
    };

    const showCompleteTrace = () => {
      clearTraceTimers();
      lab?.removeAttribute('data-running');
      graph?.setAttribute('data-edge-ready', '');
      logViewport?.setAttribute('aria-busy', 'false');
      logLines.forEach((line) => {
        line.removeAttribute('data-active');
        line.removeAttribute('aria-current');
        line.setAttribute('data-complete', '');
      });
      if (logViewport) logViewport.scrollTop = 0;
      if (stepLabel) stepLabel.textContent = 'Captured trace complete';
      if (traceStatus) {
        traceStatus.textContent =
          'Complete trace shown. Replay it to follow the pipeline one step at a time.';
      }
      if (runButton) {
        runButton.disabled = false;
        runButton.textContent = 'Replay trace';
      }
    };

    const runTrace = () => {
      clearTraceTimers();
      lab?.setAttribute('data-running', '');
      const activeRun = runId;
      graph?.removeAttribute('data-edge-ready');
      logViewport?.setAttribute('aria-busy', 'true');
      logLines.forEach((line) => {
        line.removeAttribute('data-active');
        line.removeAttribute('data-complete');
        line.removeAttribute('aria-current');
      });
      if (logViewport) logViewport.scrollTop = 0;
      if (stepLabel) stepLabel.textContent = 'Building compiler program';
      if (traceStatus)
        traceStatus.textContent = 'Replay in progress. Every captured line remains readable.';
      if (runButton) {
        runButton.disabled = true;
        runButton.textContent = 'Replaying...';
      }

      if (motionQuery.matches) {
        showCompleteTrace();
        if (traceStatus) traceStatus.textContent = 'Replay completed without animation.';
        return;
      }

      logLines.forEach((line, index) => {
        const delay = index * 180;
        const timer = window.setTimeout(() => {
          if (activeRun !== runId) return;
          const previous = logLines[index - 1];
          previous?.removeAttribute('data-active');
          previous?.removeAttribute('aria-current');
          previous?.setAttribute('data-complete', '');
          line.setAttribute('data-active', '');
          line.setAttribute('aria-current', 'step');
          if (logViewport) {
            const targetTop = Math.max(0, line.offsetTop - logViewport.clientHeight * 0.45);
            logViewport.scrollTop = targetTop;
          }
          if (stepLabel) {
            if (index < 5) stepLabel.textContent = 'Building compiler program';
            else if (index < 8) stepLabel.textContent = 'Reading import evidence';
            else if (index < 14) stepLabel.textContent = 'Resolving and projecting edges';
            else stepLabel.textContent = 'Evaluating the rule';
          }
          if (traceStatus) {
            traceStatus.textContent = `Trace step ${index + 1} of ${logLines.length}: ${line.textContent ?? ''}`;
          }
          if (index >= 8) graph?.setAttribute('data-edge-ready', '');
          if (index === logLines.length - 1) {
            line.removeAttribute('data-active');
            line.removeAttribute('aria-current');
            line.setAttribute('data-complete', '');
            timers = [];
            lab?.removeAttribute('data-running');
            logViewport?.setAttribute('aria-busy', 'false');
            if (runButton) runButton.disabled = false;
            if (runButton) runButton.textContent = 'Replay trace';
            if (stepLabel) stepLabel.textContent = '1 violation found';
            if (traceStatus)
              traceStatus.textContent = 'Replay complete. One forbidden edge became one violation.';
          }
        }, delay);
        timers.push(timer);
      });
    };

    root.setAttribute('data-enhanced', '');
    lab?.setAttribute('data-enhanced', '');
    showCompleteTrace();
    runButton?.addEventListener('click', runTrace);
    showAllButton?.addEventListener('click', showCompleteTrace);
    motionQuery.addEventListener('change', (event) => {
      if (event.matches && lab?.hasAttribute('data-running')) showCompleteTrace();
    });

    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]'));
    const chapterStrip = root.querySelector<HTMLElement>('.deep-chapters > .deep-shell');
    const sections = links
      .map((link) => document.getElementById(link.dataset.chapterLink ?? ''))
      .filter((section): section is HTMLElement => section !== null);

    let chapterFrame = 0;
    let currentChapterId = '';
    const updateCurrentChapter = () => {
      const marker = globalThis.scrollY + Math.max(150, globalThis.innerHeight * 0.28);
      const current = sections.reduce((active, section) => {
        const top = section.getBoundingClientRect().top + globalThis.scrollY;
        return top <= marker ? section : active;
      }, sections[0]);
      links.forEach((link) => {
        const isCurrent = link.dataset.chapterLink === current?.id;
        link.toggleAttribute('data-current', isCurrent);
        if (isCurrent) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (
        current &&
        current.id !== currentChapterId &&
        chapterStrip &&
        globalThis.matchMedia('(max-width: 760px)').matches
      ) {
        currentChapterId = current.id;
        const currentLink = links.find((link) => link.dataset.chapterLink === current.id);
        if (currentLink) {
          const left =
            currentLink.offsetLeft - chapterStrip.clientWidth / 2 + currentLink.clientWidth / 2;
          chapterStrip.scrollTo({ left, behavior: motionQuery.matches ? 'auto' : 'smooth' });
        }
      } else if (current) {
        currentChapterId = current.id;
      }
    };
    const scheduleChapterUpdate = () => {
      if (chapterFrame) return;
      chapterFrame = globalThis.requestAnimationFrame(() => {
        updateCurrentChapter();
        chapterFrame = 0;
      });
    };
    globalThis.addEventListener('scroll', scheduleChapterUpdate, { passive: true });
    updateCurrentChapter();
  }
</script>

