---
import CodeWindow from './CodeWindow.astro';
import InlineCode from './InlineCode.astro';

const pythonDiscovery = [
  '# The fluent builder stores project_path. Extraction resolves it here.',
  'root = os.path.abspath(project_path or os.getcwd())',
  '',
  '# os.walk yields one directory at a time: its path,',
  '# mutable child-directory names, and the file names inside it.',
  'for dirpath, dirnames, filenames in os.walk(root):',
  '    # Example before filtering: ["src", ".venv", "build"]',
  '    # Replace this same list\'s contents, so os.walk sees ["src"]',
  '    # and never descends into .venv or build.',
  '    dirnames[:] = [',
  '        name for name in dirnames',
  '        if not _should_exclude_path(',
  '            os.path.join(dirpath, name), root, exclude, is_dir=True',
  '        )',
  '    ]',
  '    for filename in filenames:',
  '        full_path = os.path.join(dirpath, filename)',
  '        if filename.endswith(".py") and not _should_exclude_path(',
  '            full_path, root, exclude, is_dir=False',
  '        ):',
  '            # Keep one stable absolute identity per Python source file.',
  '            py_files.append(os.path.abspath(full_path))',
].join('\n');

const pythonAst = [
  'def _extract_located_imports(file_path):',
  '    # Decode the complete .py file into one Python string.',
  '    try:',
  '        with open(file_path, "r", encoding="utf-8", errors="replace") as file:',
  '            source = file.read()',
  '    except (OSError, IOError):',
  '        return []',
  '',
  '    # filename labels parser diagnostics; ast.parse does not read the file.',
  '    try:',
  '        tree = ast.parse(source, filename=file_path)',
  '    except SyntaxError:',
  '        return []',
  '',
  '    imports = []',
  '    ignore_directives = _find_ignore_directives(source)',
  '    type_checking_ranges = _find_type_checking_ranges(tree)',
  '    conditional_import_ranges = _find_conditional_import_ranges(tree)',
  '    # Walk descendants because imports may be nested in functions or try blocks.',
  '    for node in ast.walk(tree):',
  '        if isinstance(node, ast.Import):',
  '            syntax_kind = ImportKind.IMPORT',
  '            kind = _classify_import(',
  '                node, syntax_kind, type_checking_ranges, conditional_import_ranges',
  '            )',
  '            for alias in node.names:',
  '                imports.append(_LocatedImport(',
  '                    alias.name, kind, node.lineno, syntax_kind',
  '                ))',
  '        elif isinstance(node, ast.ImportFrom):',
  '            # Relative and from-import nodes follow the same record pipeline.',
  '            ...',
  '        elif isinstance(node, ast.Call):',
  '            # Only literal importlib/__import__ module names can be recorded.',
  '            ...',
  '    # Apply inline and next-line # archunit: ignore directives.',
  '    return [',
  '        item for item in imports',
  '        if not _is_ignored_import(item, ignore_directives)',
  '    ]',
].join('\n');

const typescriptConfigDiscovery = [
  '// projectFiles(explicitPath) uses that config. Without one, start at cwd.',
  'const configFile = explicitPath ?? guessLocationOfTsconfig();',
  '',
  'function guessLocationOfTsconfigRecursively(directory: string) {',
  '  const names = fs.readdirSync(directory);',
  "  if (names.includes('tsconfig.json')) {",
  "    return path.resolve(directory, 'tsconfig.json');",
  '  }',
  '',
  "  const parent = path.resolve(directory, '..');",
  '  if (parent === path.resolve(directory)) return undefined;',
  '  // Search upward through parents, not downward through child folders.',
  '  return guessLocationOfTsconfigRecursively(parent);',
  '}',
  '',
  '// The directory containing the selected config becomes the root.',
  'const rootDir = path.dirname(path.resolve(configFile));',
].join('\n');

const typescriptProgram = [
  'function visitConfig(candidate: string) {',
  '  const config = ts.readConfigFile(candidate, ts.sys.readFile);',
  '  const parsed = ts.parseJsonConfigFileContent(',
  '    config.config, ts.sys, path.dirname(candidate), {}, candidate',
  '  );',
  '',
  '  contexts.push(parsed);',
  '  // Project references are visited explicitly and protected by a Set.',
  '  for (const reference of parsed.projectReferences ?? []) {',
  '    visitConfig(ts.resolveProjectReferencePath(reference));',
  '  }',
  '}',
  '',
  'const files = [...new Set(contexts.flatMap(c => c.fileNames))];',
  'const host = ts.createCompilerHost(rootOptions);',
  'const program = ts.createProgram({ rootNames: files, options: rootOptions, host });',
  '',
  'for (const sourceFile of program.getSourceFiles()) {',
  '  // At SourceFile level, this visits top-level syntax children.',
  '  ts.forEachChild(sourceFile, node => {',
  '    if (ts.isImportDeclaration(node)) recordImport(node, sourceFile);',
  '  });',
  '}',
].join('\n');

const typescriptResolution = [
  '// The AST gives us module text, but not a concrete target file.',
  'const moduleText = importNode.moduleSpecifier.text;',
  'const normalizedSourceFileName = relativeToRoot(sourceFile.fileName);',
  '',
  '// A source file can belong to more than one referenced config.',
  '// The Map deduplicates contexts that resolve to the same target.',
  'const resolvedModules = new Map<string, ts.ResolvedModuleFull>();',
  'for (const compilerOptions of sourceCompilerOptions) {',
  '  try {',
  '    let resolved = ts.resolveModuleName(',
  '      moduleText, sourceFile.fileName, compilerOptions, compilerHost',
  '    ).resolvedModule;',
  '',
  "    // If normal resolution fails, try the extractor's path suggestion.",
  '    if (!resolved) {',
  '      const suggestion = new ImportPathsResolver(compilerOptions)',
  '        .getImportSuggestions(',
  '          moduleText, path.dirname(normalizedSourceFileName)',
  '        )?.[0];',
  '      if (suggestion && suggestion !== moduleText) {',
  '        resolved = ts.resolveModuleName(',
  '          suggestion, sourceFile.fileName, compilerOptions, compilerHost',
  '        ).resolvedModule;',
  '      }',
  '    }',
  '',
  '    if (!resolved) continue;',
  '    const identity = `${normalizeFileIdentity(resolved.resolvedFileName)}:`',
  '      + `${resolved.isExternalLibraryImport ?? false}`;',
  '    resolvedModules.set(identity, resolved);',
  '  } catch {',
  '    // One failed compiler context does not prevent trying the others.',
  '    continue;',
  '  }',
  '}',
  '',
  'for (const resolved of resolvedModules.values()) {',
  '  const target = relativeToRoot(resolved.resolvedFileName);',
  '  const excluded =',
  '    (EXCLUDE_NODE_MODULES && target.startsWith("node_modules")) ||',
  '    (EXCLUDE_DIST && target.startsWith("dist"));',
  '  if (excluded) {',
  '    continue;',
  '  }',
  '  edges.push({',
  '    source: normalizedSourceFileName,',
  '    target,',
  '    external: resolved.isExternalLibraryImport ?? false,',
  '    importKinds: determineImportKinds(importNode),',
  '  });',
  '}',
  '',
  '// A self-edge is also added for every project file.',
].join('\n');

const pythonResolution = [
  '# One located import can resolve to multiple namespace-package targets.',
  'for resolved, is_external in _resolve_import_targets(',
  '    located_import, file_path, project_path',
  '):',
  '    # Do not duplicate the self-edge already used to preserve the node.',
  '    if resolved and resolved != _normalize(file_path):',
  '        # An internal target must belong to the discovered Python file set.',
  '        if not is_external and resolved not in normalized_py_file_set:',
  '            continue',
  '',
  '        edges.append(Edge(',
  '            source=_normalize(file_path),',
  '            target=resolved,',
  '            external=is_external,',
  '            import_kinds=_edge_import_kinds(located_import),',
  '        ))',
  '',
  '# Equal source/target pairs become one edge with combined import kinds.',
  'return _merge_edges(edges)',
].join('\n');

const pythonRule = [
  '# Build a lazy architecture sentence. No project scan happens yet.',
  'rule = (',
  '    project_files("src/")',
  '    # Subject: only files under a UI folder.',
  '    .in_folder("**/ui/**")',
  '    # Mood and predicate: forbid matching dependency edges.',
  '    .should_not()',
  '    .depend_on_files()',
  '    # Object: dependency targets under a DB folder.',
  '    .in_folder("**/db/**")',
  '    .because("UI code must not own persistence")',
  ')',
  '',
  '# The assertion terminal extracts, evaluates, and fails on findings.',
  'assert_passes(rule)',
].join('\n');

const typescriptRule = [
  '// Build the same lazy sentence with TypeScript naming.',
  'const rule = projectFiles("tsconfig.json")',
  "  .inFolder('src/ui')",
  '  .shouldNot()',
  '  .dependOnFiles()',
  "  .inFolder('src/db');",
  '',
  '// check() triggers extraction and returns structured violations.',
  'const violations = await rule.check({',
  '  clearCache: true,',
  "  logging: { enabled: true, level: 'debug' },",
  '});',
].join('\n');

const pythonEvaluation = [
  '# DependOnFileCondition.check(): extract, project, then delegate.',
  'graph = extract_graph(self._project_path, options=options)',
  'edges = project_edges(graph, per_internal_edge())',
  'return gather_depend_on_file_violations(',
  '    edges,',
  '    self._subject_filters,',
  '    self._object_filters,',
  '    self._is_negated,',
  ')',
  '',
  '# gather_depend_on_file_violations(): inspect each projected edge.',
  'for edge in edges:',
  '    # All subject filters must accept the importing file.',
  '    source_matches = all(',
  '        matches_pattern(edge.source_label, f) for f in subject_filters',
  '    )',
  '    if not source_matches:',
  '        continue',
  '',
  '    # All object filters must accept the resolved target file.',
  '    target_matches = all(',
  '        matches_pattern(edge.target_label, f) for f in object_filters',
  '    )',
  '    # For should_not(), a matching source and target is forbidden.',
  '    if is_negated and target_matches:',
  '        violations.append(ViolatingFileDependency(',
  '            dependency=edge, is_negated=True',
  '        ))',
].join('\n');

const typescriptEvaluation = [
  '// DependOnFileCondition.check(): extract, project, then delegate.',
  'const graph = await extractGraph(configFileName, options);',
  '// perEdge() keeps external and self-edges; equal label pairs are grouped.',
  'const projectedEdges = projectEdges(graph, perEdge());',
  '// These aliases shorten the current builder fields for this excerpt.',
  'const sourceFilters = this.dependOnFileConditionBuilder',
  '  .matchPatternFileConditionBuilder',
  '  .filesShouldCondition.filters;',
  'const targetFilters = this.dependencyFilters;',
  'const isNegated = this.dependOnFileConditionBuilder',
  '  .matchPatternFileConditionBuilder.isNegated;',
  'const allowEmptyTests = options?.allowEmptyTests || false;',
  'return gatherDependOnFileViolations(',
  '  projectedEdges,',
  '  sourceFilters,',
  '  targetFilters,',
  '  isNegated,',
  '  allowEmptyTests,',
  ');',
  '',
  '// gatherDependOnFileViolations(): select both ends of each edge.',
  'const matchingSources = projectedEdges.filter((edge) =>',
  '  matchesAllPatterns(edge.sourceLabel, sourceFilters),',
  ');',
  'const matchingTargets = projectedEdges.filter((edge) =>',
  '  matchesAllPatterns(edge.targetLabel, targetFilters),',
  ');',
  'if (matchingSources.length === 0 && !allowEmptyTests) {',
  '  return [new EmptyTestViolation(sourceFilters)];',
  '}',
  'if (matchingTargets.length === 0 && !allowEmptyTests) {',
  '  return [new EmptyTestViolation(targetFilters)];',
  '}',
  '',
  '// For shouldNot(), an edge selected at both ends is forbidden.',
  'return projectedEdges',
  '  .filter((edge) =>',
  '    isNegated',
  '      ? matchingSources.includes(edge) && matchingTargets.includes(edge)',
  '      : !matchingSources.includes(edge) || !matchingTargets.includes(edge),',
  '  )',
  '  .map((edge) => new ViolatingFileDependency(edge, isNegated));',
].join('\n');

const assertionBoundary = [
  'def assert_passes(checkable, options=None):',
  '    # Keep evaluation as data until the test boundary.',
  '    violations = checkable.check(options)',
  '    if violations:',
  '        # Carry the architectural reason into the failure message.',
  '        because = getattr(checkable, "because_reason", None)',
  '        raise AssertionError(',
  '            format_violations(violations, because=because)',
  '        )',
].join('\n');

const typescriptAssertionBoundary = [
  'expect.extend({',
  '  async toPassAsync(checkable, options) {',
  '    if (!checkable) {',
  '      return ResultFactory.error(',
  "        'expected something checkable as an argument for expect()',",
  '      );',
  '    }',
  '',
  '    // The rule still returns data at this point.',
  '    const violations = await checkable.check(options);',
  '    const testViolations = violations.map((violation) =>',
  '      ViolationFactory.from(violation),',
  '    );',
  '',
  '    // Jest or Vitest receives the final pass flag and message function.',
  '    return ResultFactory.result(Boolean(this.isNot), testViolations);',
  '  },',
  '});',
].join('\n');

const realTrace = [
  { level: 'info', text: '[INFO] Starting architecture rule check: Dependency check: 1 filters' },
  {
    level: 'info',
    text: '[INFO] Using TypeScript config file: <repo>/test/layered-arch/layered-arch-1/tsconfig.json',
  },
  { level: 'info', text: '[INFO] TypeScript program created with 199 source files' },
  { level: 'debug', text: '[DEBUG] Project source files: 2' },
  { level: 'debug', text: '[DEBUG] Node modules files: 197' },
  { level: 'debug', text: '[DEBUG] Processing file 1/2: src/db/db.ts' },
  { level: 'debug', text: '[DEBUG] Processing file 2/2: src/ui/ui.ts' },
  { level: 'debug', text: '[DEBUG] Processing import: "../db/db" in src/ui/ui.ts' },
  { level: 'debug', text: '[DEBUG] Resolved "../db/db" to: src/db/db.ts (external: false)' },
  { level: 'info', text: '[INFO] Import analysis completed:' },
  { level: 'info', text: '[INFO]   - Total edges found: 132' },
  { level: 'info', text: '[INFO]   - Files processed: 2' },
  { level: 'info', text: '[INFO] Graph extraction completed with 132 edges' },
  { level: 'debug', text: '[DEBUG] Analyzing dependencies across 124 edges' },
  { level: 'info', text: '[INFO] Found edge: From src/ui/ui.ts to src/db/db.ts' },
  {
    level: 'warn',
    text: '[WARN] Violation found: Dependency violation: {"dependency":{"sourceLabel":"src/ui/ui.ts","targetLabel":"src/db/db.ts","cumulatedEdges":[{"source":"src/ui/ui.ts","target":"src/db/db.ts","external":false,"importKinds":["value","named"]}]},"isNegated":true}',
  },
  {
    level: 'warn',
    text: '[WARN] Completed architecture rule check: Dependency check: 1 filters (1 violations)',
  },
];

const chapters = [
  ['mental-model', '01', 'Mental model'],
  ['discover-parse', '02', 'Discover and parse'],
  ['resolve-graph', '03', 'Resolve and graph'],
  ['fluent-rule', '04', 'Fluent rule'],
  ['evaluate', '05', 'Evaluate'],
  ['algorithms', '06', 'Algorithms'],
  ['feedback', '07', 'Feedback'],
];

const languageAdapters = [
  { id: 'python', label: 'Python', available: true },
  { id: 'typescript', label: 'TypeScript', available: true },
  { id: 'dotnet', label: '.NET', available: false },
  { id: 'ruby', label: 'Ruby', available: false },
  { id: 'rust', label: 'Rust', available: false },
  { id: 'zig', label: 'Zig', available: false },
  { id: 'go', label: 'Go', available: false },
  { id: 'java', label: 'Java', available: false },
  { id: 'php', label: 'PHP', available: false },
];

const unavailableAdapters = languageAdapters.filter((adapter) => !adapter.available);
---

<div class="deep-how" data-deep-how>
  <section class="deep-hero" id="mental-model">
    <div class="deep-shell deep-hero__grid">
      <div>
        <p class="deep-kicker">How ArchUnit works, from first principles</p>
        <h1>Source code becomes a graph. Rules become questions.</h1>
      </div>
      <div class="deep-hero__copy">
        <p>
          ArchUnit does not run your application and watch requests move through it. It inspects
          source structure, resolves dependency evidence, builds a directed graph, and evaluates a
          precise architectural sentence against that graph.
        </p>
        <p>
          The language adapter changes. Python reads Python syntax; TypeScript asks the TypeScript
          compiler. The reasoning after extraction stays recognizable.
        </p>
      </div>
    </div>
    <div class="deep-shell deep-equation" aria-label="The ArchUnit processing model">
      <span>source text</span>
      <b>→</b>
      <span>syntax</span>
      <b>→</b>
      <span>resolved imports</span>
      <b>→</b>
      <span>directed graph</span>
      <b>→</b>
      <span>rule projection</span>
      <b>→</b>
      <span>violations</span>
    </div>
  </section>

  <nav class="deep-chapters" aria-label="How ArchUnit Works chapters">
    <div class="deep-shell">
      {chapters.map(([id, number, label]) => (
        <a href={'#' + id} data-chapter-link={id}>
          <span>{number}</span>
          {label}
        </a>
      ))}
    </div>
  </nav>

  <section class="deep-section deep-principles">
    <div class="deep-shell">
      <div class="deep-section-heading">
        <p class="deep-kicker">The smallest useful model</p>
        <h2>Four terms are enough to follow the walkthrough.</h2>
        <p>
          These terms give us a shared vocabulary. The later chapters show the implementation
          details, language adaptations, projections, algorithms, and test integration behind them.
        </p>
      </div>
      <div class="principle-grid">
        <article>
          <span>01</span>
          <h3>Node</h3>
          <p>
            A stable identity for something architecture rules can talk about. File rules primarily
            use source files such as <InlineCode code="src/ui/ui.ts" language="typescript" />.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Directed edge</h3>
          <p>
            An arrow from the depender to the dependency. If A imports B, the graph records
            <InlineCode code="A → B" language="text" />. Direction is architectural evidence.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Projection</h3>
          <p>
            A focused view of the raw graph. The same edges can be viewed as files, folders, layers,
            slices, internal dependencies, external modules, or cycle paths.
          </p>
        </article>
        <article>
          <span>04</span>
          <h3>Violation</h3>
          <p>
            Structured evidence that the projected graph disagrees with a rule. It remains data
            until a test adapter decides to raise, fail, print, or render it.
          </p>
        </article>
      </div>
      <aside class="not-dag" aria-label="A note about cycles">
        <strong>Directed does not mean acyclic.</strong>
        <p>
          A DAG is a directed acyclic graph. ArchUnit does not assume the project graph is a DAG:
          real code can contain return paths, and detecting those cycles is one of the library's
          jobs.
        </p>
      </aside>
    </div>
  </section>

  <section class="deep-section deep-discovery" id="discover-parse">
    <div class="deep-shell">
      <div class="deep-section-heading deep-section-heading--wide">
        <p class="deep-kicker">Chapter 02 / Discover and parse</p>
        <h2>Choose an adapter, then follow source code into syntax evidence.</h2>
        <p>
          Static analysis means inspecting program text and its structure without executing the
          application. The shared goal is the same in every language, but the project boundary,
          parser, and supported syntax are language-specific.
        </p>
      </div>

      <div class="adapter-picker" data-adapter-picker hidden>
        <div>
          <p class="deep-kicker">Language adapter</p>
          <p>Select a language to change the discovery, parsing, and resolution walkthrough.</p>
        </div>
        <div class="adapter-tabs" role="tablist" aria-label="Choose a language adapter">
          {languageAdapters.map((adapter, index) => (
            <button
              type="button"
              role="tab"
              id={'adapter-tab-' + adapter.id}
              aria-controls={'adapter-discover-' + adapter.id + ' adapter-resolve-' + adapter.id}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? '0' : '-1'}
              data-adapter-tab={adapter.id}
            >
              {adapter.label}
              {!adapter.available && <span>Preview</span>}
            </button>
          ))}
        </div>
        <p class="adapter-status" data-adapter-status aria-live="polite">
          Python adapter selected.
        </p>
      </div>

      <div
        class="adapter-panel"
        id="adapter-discover-python"
        role="tabpanel"
        aria-labelledby="adapter-tab-python"
        data-adapter-panel="python"
        data-adapter-stage="discover"
      >
        <div class="adapter-panel-intro">
          <p class="deep-kicker">Python adapter</p>
          <h3>A directory root becomes decoded source text, then an Abstract Syntax Tree.</h3>
          <p>
            Nothing is imported or executed. ArchUnitPython chooses a root, discovers supported
            files below it, reads each file as text, and asks Python's standard parser for a syntax
            tree.
          </p>
        </div>

        <ol class="adapter-steps">
          <li>
            <div class="adapter-step-number">01</div>
            <div>
              <h3>Establish the project root.</h3>
              <p>
                <InlineCode code='project_files("src/")' language="python" /> stores the supplied
                path until <InlineCode code="check()" language="python" /> runs. Extraction turns it
                into an absolute path. If no path is supplied,
                <InlineCode code="os.getcwd()" language="python" /> uses the test process's current
                working directory. This one root anchors discovery,
                <InlineCode code=".archignore" language="text" />, caching, and the decision that a
                resolved target belongs to this project.
              </p>
            </div>
          </li>
          <li>
            <div class="adapter-step-number">02</div>
            <div>
              <h3>Walk the directory tree without entering excluded folders.</h3>
              <p>
                <InlineCode code="os" language="python" /> is Python's built-in operating-system
                module. <InlineCode code="os.walk(root)" language="python" /> works top down and
                yields three values for each folder: its path, a mutable list of immediate child
                folder names, and a list of filenames.
              </p>
              <div
                class="plain-example"
                aria-label="How dirnames slice assignment prunes traversal"
              >
                <p>
                  <strong>Before filtering</strong>{' '}
                  <InlineCode code='["src", ".venv", "build"]' language="python" />
                </p>
                <p>
                  <strong>
                    After <InlineCode code="dirnames[:]" language="python" />
                  </strong>{' '}
                  <InlineCode code='["src"]' language="python" />
                </p>
              </div>
              <p>
                <InlineCode code="dirnames[:] = kept_names" language="python" /> replaces the
                contents of that same list object. <InlineCode code="os.walk()" language="python" />
                consults the list before descending, so it enters only
                <InlineCode code="src" language="text" />. This does not rename or delete folders.
                Assigning a new local list with{' '}
                <InlineCode code="dirnames = kept_names" language="python" />
                would not change the list held by <InlineCode code="os.walk()" language="python" />.
              </p>
            </div>
          </li>
          <li>
            <div class="adapter-step-number">03</div>
            <div>
              <h3>Read one file into the form this parser uses.</h3>
              <p>
                A source file begins as bytes on disk. Opening it in text mode with UTF-8 decoding
                and calling <InlineCode code="file.read()" language="python" /> consumes the
                complete file to its end and returns one Python{' '}
                <InlineCode code="str" language="python" />.
                <InlineCode code='errors="replace"' language="python" /> substitutes malformed byte
                sequences rather than aborting the whole scan. This implementation passes that
                decoded source string to <InlineCode code="ast.parse()" language="python" />.
              </p>
            </div>
          </li>
          <li>
            <div class="adapter-step-number">04</div>
            <div>
              <h3>Parse syntax, then visit its descendants.</h3>
              <p>
                AST means Abstract Syntax Tree.{' '}
                <InlineCode code="ast.parse(source)" language="python" />
                returns an <InlineCode code="ast.Module" language="python" /> whose child nodes
                represent statements and expressions. The
                <InlineCode code="filename=file_path" language="python" /> argument labels parser
                diagnostics; it does not read the file.{' '}
                <InlineCode code="ast.walk(tree)" language="python" />
                recursively yields every descendant, so the outer loop can see imports nested in
