---
import { contactEmail } from '@data/contributors';

const path = Astro.url.pathname;
interface NavigationLink {
  href: string;
  label: string;
  copy: string;
  external?: boolean;
}

interface NavigationGroup {
  id: string;
  label: string;
  links: NavigationLink[];
}

const navigationGroups: NavigationGroup[] = [
  {
    id: 'products',
    label: 'Products',
    links: [
      { href: '/#libraries', label: 'Libraries', copy: 'Architecture tests for nine ecosystems.' },
      {
        href: '/enterprise/',
        label: 'Enterprise',
        copy: 'Roll out architecture policy across teams.',
      },
      {
        href: '/use-cases/',
        label: 'Use cases',
        copy: 'Boundaries, cycles, migrations, and design health.',
      },
      {
        href: '/integrations/',
        label: 'Integrations',
        copy: 'Fit guardrails into the tools you already run.',
      },
    ],
  },
  {
    id: 'developers',
    label: 'Developers',
    links: [
      {
        href: '/how-archunit-works/',
        label: 'How it works',
        copy: 'From source extraction to evaluated rules.',
      },
      { href: '/stats/', label: 'Project stats', copy: 'Adoption and ecosystem activity.' },
      {
        href: 'https://github.com/LukasNiessen',
        label: 'GitHub',
        copy: 'Source, issues, releases, and contribution.',
        external: true,
      },
      { href: '/status/', label: 'Status', copy: 'Availability of the public project surfaces.' },
    ],
  },
  {
    id: 'resources',
    label: 'Resources',
    links: [
      {
        href: '/resources/',
        label: 'Resource library',
        copy: 'White papers, case studies, and field guides.',
      },
      { href: '/blog/', label: 'Blog', copy: 'Technical analysis and project thinking.' },
      {
        href: '/why-architecture-tests/',
        label: 'Why architecture tests',
        copy: 'The case for executable architecture decisions.',
      },
      { href: '/support/', label: 'Support', copy: 'Adoption, implementation, and project help.' },
    ],
  },
  {
    id: 'company',
    label: 'Company',
    links: [
      { href: '/about/', label: 'About', copy: 'Why we build architecture guardrails.' },
      { href: '/mission/', label: 'Mission', copy: 'The future we want software teams to build.' },
      {
        href: '/principles/',
        label: 'Principles',
        copy: 'The operating ideas behind our work.',
      },
      { href: '/team/', label: 'People', copy: 'Meet the team behind the libraries.' },
      { href: '/jobs/', label: 'Jobs', copy: 'Build language-native developer tools with us.' },
    ],
  },
];

const contactHref = `mailto:${contactEmail}?subject=${encodeURIComponent('ArchUnit sales inquiry')}`;
---

<header class="site-header" data-header>
  <div class="header-inner">
    <div class="header-left">
      <a class="brand" href="/" aria-label="ArchUnit home">
        <img class="brand-logo" src="/logos/archunitts.png" alt="" width="34" height="34" />
        <span class="brand-wordmark">
          Arch<span>Unit</span>
        </span>
      </a>

      <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
        {navigationGroups.map((group) => {
          const active = group.links.some(
            (link) => !link.external && link.href !== '/#libraries' && path.startsWith(link.href),
          );
          return (
            <div class:list={['nav-dropdown', { active }]} data-nav-dropdown>
              <button
                class="nav-dropdown__trigger"
                type="button"
                aria-expanded="false"
                aria-controls={`${group.id}-menu`}
                data-nav-toggle
              >
                {group.label}
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m4 6 4 4 4-4"></path>
                </svg>
              </button>
              <div id={`${group.id}-menu`} class="nav-dropdown__panel">
                <p>{group.label}</p>
                {group.links.map((link) => (
                  <a
                    href={link.href}
                    class:list={{
                      active:
                        !link.external && link.href !== '/#libraries' && path.startsWith(link.href),
                    }}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noreferrer' : undefined}
                  >
                    <strong>{link.label}</strong>
                    <span>{link.copy}</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}

        <div class="mobile-nav-actions">
          <a class="button button--ghost" href={contactHref}>
            Contact sales
          </a>
          <a class="button button--lime" href="/#libraries">
            Get started
          </a>
        </div>
      </nav>
    </div>

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Use light mode">
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
        </svg>
        <span class="sr-only" data-theme-label>
          Use light mode
        </span>
      </button>
      <a class="button button--small button--ghost header-contact" href={contactHref}>
        Contact sales
      </a>
      <a class="button button--small button--lime header-started" href="/#libraries">
        Get started
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav">
        <span class="sr-only">Toggle navigation</span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('.primary-nav');
  const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-nav-dropdown]')];

  const closeDropdowns = (except?: HTMLElement) => {
    dropdowns.forEach((dropdown) => {
      if (dropdown === except) return;
      dropdown.removeAttribute('data-open');
      dropdown
        .querySelector<HTMLButtonElement>('[data-nav-toggle]')
        ?.setAttribute('aria-expanded', 'false');
    });
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    navigation?.toggleAttribute('data-open', !isOpen);
    if (isOpen) closeDropdowns();
  });

  dropdowns.forEach((dropdown) => {
    const button = dropdown.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    button?.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      closeDropdowns(dropdown);
      button.setAttribute('aria-expanded', String(!isOpen));
      dropdown.toggleAttribute('data-open', !isOpen);
    });
  });

  navigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      navigation.removeAttribute('data-open');
      closeDropdowns();
    });
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node) || navigation?.contains(event.target)) return;
    closeDropdowns();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menuButton?.setAttribute('aria-expanded', 'false');
    navigation?.removeAttribute('data-open');
    closeDropdowns();
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = themeToggle?.querySelector<HTMLElement>('[data-theme-label]');
  const updateThemeControl = () => {
    const isDark = document.documentElement.dataset.theme !== 'light';
    const label = isDark ? 'Use light mode' : 'Use dark mode';
    themeToggle?.setAttribute('aria-label', label);
    if (themeLabel) themeLabel.textContent = label;
  };
  updateThemeControl();
  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    document.documentElement.style.colorScheme = next;
    localStorage.setItem('archunit-theme', next);
    document
      .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'light' ? '#f3f5f8' : '#06080d');
    updateThemeControl();
  });
</script>
