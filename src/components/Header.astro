---
import { contactEmail } from '@data/contributors';

const path = Astro.url.pathname;
const links = [
  { href: '/#libraries', label: 'Libraries' },
  { href: '/how-archunit-works/', label: 'How it works' },
  { href: '/stats/', label: 'Stats' },
  { href: '/blog/', label: 'Blog' },
];
const companyLinks = [
  { href: '/about/', label: 'About', copy: 'Why we build architecture guardrails.' },
  { href: '/team/', label: 'People', copy: 'Meet the team behind the libraries.' },
  { href: '/jobs/', label: 'Jobs', copy: 'Build language-native developer tools with us.' },
];
const companyActive = companyLinks.some((link) => path.startsWith(link.href));
const contactHref = `mailto:${contactEmail}?subject=${encodeURIComponent('ArchUnit inquiry')}`;
---

<header class="site-header" data-header>
  <div class="header-inner">
    <div class="header-left">
      <a class="brand" href="/" aria-label="ArchUnit home">
        <img class="brand-logo" src="/logos/archunitts.png" alt="" width="34" height="34" />
        <span class="brand-wordmark">ArchUnit</span>
      </a>

      <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={{ active: link.href !== '/#libraries' && path.startsWith(link.href) }}
          >
            {link.label}
          </a>
        ))}

        <div class:list={['nav-dropdown', { active: companyActive }]} data-company-dropdown>
          <button
            class="nav-dropdown__trigger"
            type="button"
            aria-expanded="false"
            aria-controls="company-menu"
            data-company-toggle
          >
            Company
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m4 6 4 4 4-4"></path>
            </svg>
          </button>
          <div id="company-menu" class="nav-dropdown__panel">
            <p>Company</p>
            {companyLinks.map((link) => (
              <a href={link.href} class:list={{ active: path.startsWith(link.href) }}>
                <strong>{link.label}</strong>
                <span>{link.copy}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="mobile-nav-actions">
          <a class="button button--ghost" href={contactHref}>
            Contact us
          </a>
          <a class="button button--lime" href="/#libraries">
            Get started
          </a>
        </div>
      </nav>
    </div>

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Use light mode">
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
        </svg>
        <span class="sr-only" data-theme-label>
          Use light mode
        </span>
      </button>
      <a class="button button--small button--ghost header-contact" href={contactHref}>
        Contact us
      </a>
      <a class="button button--small button--lime header-started" href="/#libraries">
        Get started
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav">
        <span class="sr-only">Toggle navigation</span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('.primary-nav');
  const companyDropdown = document.querySelector<HTMLElement>('[data-company-dropdown]');
  const companyButton = document.querySelector<HTMLButtonElement>('[data-company-toggle]');

  const closeCompanyMenu = () => {
    companyButton?.setAttribute('aria-expanded', 'false');
    companyDropdown?.removeAttribute('data-open');
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!isOpen));
    navigation?.toggleAttribute('data-open', !isOpen);
    if (isOpen) closeCompanyMenu();
  });

  companyButton?.addEventListener('click', () => {
    const isOpen = companyButton.getAttribute('aria-expanded') === 'true';
    companyButton.setAttribute('aria-expanded', String(!isOpen));
    companyDropdown?.toggleAttribute('data-open', !isOpen);
  });

  navigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      navigation.removeAttribute('data-open');
      closeCompanyMenu();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menuButton?.setAttribute('aria-expanded', 'false');
    navigation?.removeAttribute('data-open');
    closeCompanyMenu();
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = themeToggle?.querySelector<HTMLElement>('[data-theme-label]');
  const updateThemeControl = () => {
    const isDark = document.documentElement.dataset.theme !== 'light';
    const label = isDark ? 'Use light mode' : 'Use dark mode';
    themeToggle?.setAttribute('aria-label', label);
    if (themeLabel) themeLabel.textContent = label;
  };
  updateThemeControl();
  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    document.documentElement.style.colorScheme = next;
    localStorage.setItem('archunit-theme', next);
    document
      .querySelector<HTMLMetaElement>('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'light' ? '#f4f2eb' : '#080a0d');
    updateThemeControl();
  });
</script>
